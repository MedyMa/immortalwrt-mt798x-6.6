+/* Default-off aggregate counters for one controlled diagnostic run. */
+static bool whnat_rx_diag_enable;
+static int whnat_diag_enable_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%c\n",
+			  READ_ONCE(*(bool *)kp->arg) ? 'Y' : 'N');
+}
+static int whnat_diag_enable_set(const char *val, const struct kernel_param *kp)
+{
+	bool enable;
+	int err = kstrtobool(val, &enable);
+
+	if (err)
+		return err;
+	WRITE_ONCE(*(bool *)kp->arg, enable);
+	return 0;
+}
+static const struct kernel_param_ops whnat_diag_enable_ops = {
+	.set = whnat_diag_enable_set,
+	.get = whnat_diag_enable_get,
+};
+module_param_cb(whnat_rx_diag_enable, &whnat_diag_enable_ops, &whnat_rx_diag_enable, 0600);
+static int whnat_rx_diag_atomic_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%lld\n", atomic64_read((atomic64_t *)kp->arg));
+}
+static const struct kernel_param_ops whnat_rx_diag_atomic_ops = { .get = whnat_rx_diag_atomic_get };
+#define WHNAT_RX_DIAG_COUNTER(name) \
+	static atomic64_t whnat_rx_diag_##name = ATOMIC64_INIT(0); \
+	module_param_cb(whnat_rx_diag_##name, &whnat_rx_diag_atomic_ops, \
+			&whnat_rx_diag_##name, 0444)
+
+WHNAT_RX_DIAG_COUNTER(desc_total);
+WHNAT_RX_DIAG_COUNTER(desc_ppe_valid);
+WHNAT_RX_DIAG_COUNTER(desc_no_ppe_valid);
+WHNAT_RX_DIAG_COUNTER(desc_hw_path);
+WHNAT_RX_DIAG_COUNTER(desc_cannot_reorder);
+WHNAT_RX_DIAG_COUNTER(desc_csrn_zero);
+WHNAT_RX_DIAG_COUNTER(desc_csrn_nonzero);
+WHNAT_RX_DIAG_COUNTER(desc_pn_fail);
+WHNAT_RX_DIAG_COUNTER(desc_repeat);
+WHNAT_RX_DIAG_COUNTER(desc_oldpkt);
+WHNAT_RX_DIAG_COUNTER(queue_rro);
+WHNAT_RX_DIAG_COUNTER(queue_msdu_pg);
+WHNAT_RX_DIAG_COUNTER(skb_built);
+WHNAT_RX_DIAG_COUNTER(skb_hw_path);
+WHNAT_RX_DIAG_COUNTER(skb_no_hw_path);
+WHNAT_RX_DIAG_COUNTER(bus_handoff);
+WHNAT_RX_DIAG_COUNTER(fifo_enqueued);
+WHNAT_RX_DIAG_COUNTER(fifo_drop);
 
 
