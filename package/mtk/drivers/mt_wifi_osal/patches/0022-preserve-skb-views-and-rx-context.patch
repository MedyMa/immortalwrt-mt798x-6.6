-unsigned int cpu_idx[] = { 0x10000000, 0xF0000000, 0x80000000, 0x40000000};
-
 bool mt_os_pkt_set_rps_hash(void *skb_, int rps_per_round)
 {
-	struct sk_buff *skb = (struct sk_buff *)skb_;
-	struct net_device *net_dev = skb->dev;
-	struct netdev_rx_queue *rxqueue = net_dev->_rx;
+#ifdef CONFIG_RPS
+	struct sk_buff *skb = skb_;
 	struct rps_map *map;
-	static int g_accnt = 0, change_idx = 0;
-	u8 *pSrcBuf = skb->data;
-
-	map = rcu_dereference(rxqueue->rps_map);
-	if (!map || map->len >= 4 || map->len == 0)
+	struct iphdr buffer;
+	const struct iphdr *iph;
+	static atomic_t sequence = ATOMIC_INIT(0);
+	u32 count, index, hash;
+
+	if (!skb || !skb->dev || !skb->dev->_rx || rps_per_round < 0)
 		return false;
-	if (map->len == 1) {
-		skb->sw_hash = 1;
-		skb->hash = cpu_idx[0];
-	} else if (pSrcBuf[0] == 0x45 && pSrcBuf[1] == 0x0 && pSrcBuf[9] == 0x11) {
-		if (g_accnt++ > rps_per_round) {
-			g_accnt = 0;
-			if (change_idx++ >= map->len)
-				change_idx = 0;
-		}
-		skb->sw_hash = 1;
-		skb->hash = cpu_idx[change_idx];
-	}
-
+	rcu_read_lock();
+	map = rcu_dereference(skb->dev->_rx->rps_map);
+	count = map ? map->len : 0;
+	rcu_read_unlock();
+	if (!count || count > 4)
+		return false;
+	if (count > 1) {
+		iph = skb_header_pointer(skb, 0, sizeof(buffer), &buffer);
+		if (!iph || iph->version != 4 || iph->ihl < 5 || iph->protocol != IPPROTO_UDP)
+			return false;
+		index = ((u32)atomic_inc_return(&sequence) / ((u32)rps_per_round + 1)) % count;
+	} else
+		index = 0;
+	/* reciprocal_scale(hash, count) selects exactly index, including count=3/4. */
+	hash = div_u64(((u64)index * 2 + 1) << 31, count);
+	skb_set_hash(skb, hash, PKT_HASH_TYPE_L3);
 	return true;
+#else
+	return false;
+#endif
 }
 EXPORT_SYMBOL(mt_os_pkt_set_rps_hash);
 
