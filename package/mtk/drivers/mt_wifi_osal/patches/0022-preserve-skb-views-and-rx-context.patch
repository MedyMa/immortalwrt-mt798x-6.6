@@ -131,31 +139,32 @@
 
 PNDIS_PACKET mt_os_clone_pkt_by_data(unsigned char MonitorOn, void *pkt, unsigned char *buf, unsigned long sz)
 {
-	struct sk_buff *pClonedPkt, *pkt_ = (struct sk_buff *)pkt;
-
-	if (pkt == NULL) {
-		MT_DEBUG_ERROR("pkt is NULL\n");
-		return NULL;
-	}
-
-	if (!MonitorOn && sz >= MAX_RX_DATA_BUFFER_SIZE ) {
-		MT_DEBUG_TRACE("pkt sz is too large %d\n", sz);
-		return NULL;
-	}
-
-
-	/* clone the packet */
-	pClonedPkt = skb_clone((struct sk_buff *)pkt, GFP_ATOMIC);
-
-	if (pClonedPkt) {
-		/* set the correct dataptr and data len */
-		pClonedPkt->dev = pkt_->dev;
-		pClonedPkt->data = buf;
-		pClonedPkt->len = sz;
-		SET_OS_PKT_DATA_TAIL(pClonedPkt, pClonedPkt->len);
-	}
-
-	return (PNDIS_PACKET)pClonedPkt;
+	struct sk_buff *source = pkt, *clone;
+	unsigned long linear;
+
+	if (!source || !buf || (!MonitorOn && sz >= MAX_RX_DATA_BUFFER_SIZE) ||
+	    (unsigned long)buf < (unsigned long)source->head ||
+	    (unsigned long)buf > (unsigned long)skb_tail_pointer(source))
+		return NULL;
+	linear = skb_tail_pointer(source) - buf;
+	if (linear > UINT_MAX - source->data_len || sz > linear + source->data_len)
+		return NULL;
+	clone = skb_clone(source, GFP_ATOMIC);
+	if (!clone)
+		return NULL;
+	clone->data = buf;
+	clone->len = linear + clone->data_len;
+	/* The selected view no longer covers the parent's checksum bytes. */
+	if (clone->ip_summed == CHECKSUM_COMPLETE || clone->ip_summed == CHECKSUM_PARTIAL) {
+		clone->ip_summed = CHECKSUM_NONE;
+		clone->csum = 0;
+		clone->csum_valid = 0;
+	}
+	if (pskb_trim(clone, sz)) {
+		kfree_skb(clone);
+		return NULL;
+	}
+	return clone;
 }
 EXPORT_SYMBOL(mt_os_clone_pkt_by_data);
 
