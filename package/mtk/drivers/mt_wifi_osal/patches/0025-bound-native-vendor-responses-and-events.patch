+
+/* The allocating variants own response; the backend fills it without replacing it. */
+static int mt_cfg80211_vndr_cmd_get_buffer(
+	struct wiphy *wiphy, struct wireless_dev *wifi_dev,
+	enum mt_cfg80211_vndr_attr_type type, unsigned int attr_cmd,
+	struct mt_cfg80211_vndr_ctrl *ctrl, unsigned int capacity)
+{
+	void *response;
+	int ret;
+
+	if (!ctrl)
+		return -EINVAL;
+	response = kzalloc(capacity, GFP_ATOMIC);
+	if (!response)
+		return -ENOMEM;
+	ctrl->rsp_data = response;
+	ctrl->rsp_data_len = capacity;
+	ctrl->sub_id = attr_cmd;
+	ret = mt_cfg80211_vndr_cmd_handler(wiphy, wifi_dev, type, ctrl);
+	if (!ret && (ctrl->rsp_data != response || ctrl->rsp_data_len > capacity))
+		ret = -EMSGSIZE;
+	if (!ret)
+		ret = mt_cfg80211_vndr_cmd_reply_msg(wiphy, attr_cmd, response, ctrl->rsp_data_len);
+	kfree(response);
+	ctrl->rsp_data = NULL;
+	ctrl->rsp_data_len = 0;
 	return ret;
 }
 
