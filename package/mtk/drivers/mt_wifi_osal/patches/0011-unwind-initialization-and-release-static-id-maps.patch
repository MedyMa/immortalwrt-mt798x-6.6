--- a/mt_osal_main.c
+++ b/mt_osal_main.c
@@ -20,6 +20,12 @@
 #include <mt_osal.h>
 #include <mt_osal_module.h>
 
+static void mt_wifi_osal_cleanup(size_t initialized)
+{
+	while (initialized)
+		__sub_mod_exitcall_start[--initialized]();
+}
+
 static int __init mt_wifi_osal_init(void)
 {
 	int ret = 0;
@@ -27,12 +33,22 @@
 
 	MT_DEBUG_TRACE_IN("");
 
+	/* Each submodule registers one init and one cleanup in object order. */
+	if (__sub_mod_initcall_end - __sub_mod_initcall_start !=
+	    __sub_mod_exitcall_end - __sub_mod_exitcall_start) {
+		MT_DEBUG_ERROR("unbalanced OSAL init/exit callbacks\n");
+		return -EINVAL;
+	}
+
 	for (sub_mod_initcall = __sub_mod_initcall_start;
 	     sub_mod_initcall < __sub_mod_initcall_end;
 	     sub_mod_initcall++) {
 		ret = (*sub_mod_initcall)();
-		if (ret)
+		if (ret) {
+			mt_wifi_osal_cleanup(sub_mod_initcall -
+					     __sub_mod_initcall_start);
 			return ret;
+		}
 	}
 
 	MT_DEBUG_TRACE_OUT("");
@@ -41,14 +57,9 @@
 
 static void __exit mt_wifi_osal_exit(void)
 {
-	exitcall_t *sub_mod_exitcall;
-
 	MT_DEBUG_TRACE_IN("");
 
-	for (sub_mod_exitcall = __sub_mod_exitcall_end - 1;
-	     sub_mod_exitcall >= __sub_mod_exitcall_start;
-	     sub_mod_exitcall--)
-		(*sub_mod_exitcall)();
+	mt_wifi_osal_cleanup(__sub_mod_exitcall_end - __sub_mod_exitcall_start);
 
 	MT_DEBUG_TRACE_OUT("");
 }
