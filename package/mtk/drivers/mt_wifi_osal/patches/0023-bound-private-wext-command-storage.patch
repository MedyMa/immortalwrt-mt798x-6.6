Subject: osal: bound WEXT query lengths and retain private command ownership

--- a/mt_osal_wifi.c
+++ b/mt_osal_wifi.c
@@ -35,6 +35,8 @@
 	struct mt_os_wifi_ioctl_cmd_cfg IoctlConfig, *pIoctlConfig = &IoctlConfig;
