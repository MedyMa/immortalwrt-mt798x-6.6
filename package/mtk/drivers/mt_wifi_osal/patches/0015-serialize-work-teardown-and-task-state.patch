+static bool mt_os_task_wait_common(MT_OS_TASK *task, unsigned int cond,
+				   int *status, bool consume)
+{
+	int ret;
+
+	if (!task) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = wait_event_interruptible(task->kthread_q,
+		READ_ONCE(task->kthread_running) ||
+		READ_ONCE(task->task_killed) || kthread_should_stop() || cond);
+	if (!ret && (READ_ONCE(task->task_killed) || kthread_should_stop()))
+		ret = -1;
+	if (consume)
+		WRITE_ONCE(task->kthread_running, false);
+out:
+	if (status)
+		*status = ret;
+	return ret == 0;
+}
+
+bool mt_os_task_wait(void *reserved, MT_OS_TASK *task, int *status)
+{
+	return mt_os_task_wait_common(task, 0, status, true);
 }
 EXPORT_SYMBOL(mt_os_task_wait);
 
