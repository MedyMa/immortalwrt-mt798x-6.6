-	void *pReserved, MT_OS_TASK *pTask, int *pStatus)
-{
-	int status;
-
-	do {
-		wait_event_interruptible(
-			pTask->kthread_q, pTask->kthread_running || kthread_should_stop());
-		pTask->kthread_running = false;
-		if (kthread_should_stop()) {
-			status = -1;
-			break;
