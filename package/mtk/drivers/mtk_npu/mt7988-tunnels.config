# MT7988 default TOPS firmware selections; also usable as a verification fragment.
# Not an installed-device settings file.
CONFIG_PACKAGE_kmod-npu=y
CONFIG_PACKAGE_kmod-npu-nf_hnat=y
CONFIG_PACKAGE_kmod-npu-autoload=y
CONFIG_PACKAGE_kmod-npu-nf_hnat-autoload=y
CONFIG_PACKAGE_npu-rebb-fw=y
CONFIG_PACKAGE_mtk-tops-accounting=y
CONFIG_MTK_NPU_24_10_TUNNEL_BACKEND=y
CONFIG_MTK_NPU_REBB_SUPPORT=y
CONFIG_MTK_NPU_SUPPORT=y
CONFIG_MTK_NPU=y
CONFIG_MTK_NPU_HNAT=y
CONFIG_MTK_NPU_MEM_TEST=y
CONFIG_MTK_NPU_THERMAL=y
CONFIG_MTK_NPU_STATISTIC=y
CONFIG_NPU_TNL_32=y
CONFIG_NPU_TNL_NUM=32
CONFIG_NPU_TNL_MAP_BIT=5
CONFIG_NPU_TNL_TYPE_NUM=32
CONFIG_MTK_NPU_GRE=y
CONFIG_MTK_NPU_GRETAP=y
CONFIG_MTK_NPU_VXLAN=y
CONFIG_MTK_NPU_L2TP=y
CONFIG_MTK_NPU_L2TP_V2=y
CONFIG_MTK_NPU_PPP=y
# CONFIG_MTK_NPU_PPTP is not set
# CONFIG_MTK_NPU_FLOW is not set
# CONFIG_MTK_NPU_MCAST is not set
# CONFIG_MTK_NPU_DPDK is not set
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-pppol2tp=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_TARGET_ROOTFS_PARTSIZE=8192
CONFIG_PACKAGE_kmod-pppoe=y
