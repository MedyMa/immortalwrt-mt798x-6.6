 #include "rt_config.h"
+#include <linux/atomic.h>
+#include <linux/moduleparam.h>
+
+/* Default-off counter for RX packets forced to the software path. */
+static bool whnat_force_rx_diag_enable;
+static int whnat_diag_enable_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%c\n",
+			  READ_ONCE(*(bool *)kp->arg) ? 'Y' : 'N');
+}
+static int whnat_diag_enable_set(const char *val, const struct kernel_param *kp)
+{
+	bool enable;
+	int err = kstrtobool(val, &enable);
+
+	if (err)
+		return err;
+	WRITE_ONCE(*(bool *)kp->arg, enable);
+	return 0;
+}
+static const struct kernel_param_ops whnat_diag_enable_ops = {
+	.set = whnat_diag_enable_set,
+	.get = whnat_diag_enable_get,
+};
+module_param_cb(whnat_force_rx_diag_enable, &whnat_diag_enable_ops, &whnat_force_rx_diag_enable, 0600);
+static atomic64_t whnat_force_rx_sw_packets = ATOMIC64_INIT(0);
+static int whnat_force_rx_sw_packets_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%lld\n", atomic64_read((atomic64_t *)kp->arg));
+}
+static const struct kernel_param_ops whnat_force_rx_sw_packets_ops = {
+	.get = whnat_force_rx_sw_packets_get,
+};
+module_param_cb(whnat_force_rx_sw_packets, &whnat_force_rx_sw_packets_ops,
+		&whnat_force_rx_sw_packets, 0444);
+
+/* Aggregate reports across all adapters/stations, not per speedtest flow.
+ * No firmware query, RX profiling, report enable or read-clear operation.
+ */
+void be14_whnat_fw_tx_diag_add(u32 total, u32 failed);
+void be14_whnat_txs_diag_add(bool me, bool re, bool le, bool be,
+                           bool txop, bool baf);
+#define BE14_TX_COUNTER(name) \
+    static atomic64_t whnat_tx_diag_##name = ATOMIC64_INIT(0); \
+    module_param_cb(whnat_tx_diag_##name, &whnat_force_rx_sw_packets_ops, \
+                    &whnat_tx_diag_##name, 0444)
+BE14_TX_COUNTER(fw_reports);
+BE14_TX_COUNTER(fw_total);
+BE14_TX_COUNTER(fw_fail);
+BE14_TX_COUNTER(txs_reports);
+BE14_TX_COUNTER(txs_me);
+BE14_TX_COUNTER(txs_re);
+BE14_TX_COUNTER(txs_le);
+BE14_TX_COUNTER(txs_be);
+BE14_TX_COUNTER(txs_txop);
+BE14_TX_COUNTER(txs_baf);
+
+void be14_whnat_fw_tx_diag_add(u32 total, u32 failed)
+{
+    if (!unlikely(READ_ONCE(whnat_force_rx_diag_enable)))
+        return;
+    atomic64_inc(&whnat_tx_diag_fw_reports);
+    atomic64_add(total, &whnat_tx_diag_fw_total);
+    atomic64_add(failed, &whnat_tx_diag_fw_fail);
+}
+
+void be14_whnat_txs_diag_add(bool me, bool re, bool le, bool be,
+                           bool txop, bool baf)
+{
+    if (!unlikely(READ_ONCE(whnat_force_rx_diag_enable)))
+        return;
+    atomic64_inc(&whnat_tx_diag_txs_reports);
+    if (me) atomic64_inc(&whnat_tx_diag_txs_me);
+    if (re) atomic64_inc(&whnat_tx_diag_txs_re);
+    if (le) atomic64_inc(&whnat_tx_diag_txs_le);
+    if (be) atomic64_inc(&whnat_tx_diag_txs_be);
+    if (txop) atomic64_inc(&whnat_tx_diag_txs_txop);
+    if (baf) atomic64_inc(&whnat_tx_diag_txs_baf);
+}
