+static BOOLEAN uni_event_validate_all_sta_tlv(
+	struct _RTMP_ADAPTER *pAd,
+	struct UNI_EVENT_ALL_STA_INFO_COMMON_T *tlv,
+	UINT32 tlv_available,
+	UINT16 *tag_out,
+	UINT16 *sta_num_out,
+	UINT32 *payload_len_out)
+{
+	UINT16 tag, sta_num, tlv_len;
+	UINT32 record_len = 0, payload_len, idx;
+	UINT16 wcid;
+	const char *reason = "invalid TLV";
+
+	if (tlv_available < sizeof(*tlv)) {
+		reason = "short common header";
+		goto invalid;
+	}
+
+	tag = le2cpu16(get_unaligned(&tlv->u2Tag));
+	tlv_len = le2cpu16(get_unaligned(&tlv->u2Length));
+	sta_num = le2cpu16(get_unaligned(&tlv->u2StaNum));
+	if (tlv_len < sizeof(*tlv) || tlv_len > tlv_available) {
+		reason = "declared TLV length out of bounds";
+		goto invalid;
+	}
+
+	payload_len = tlv_len - sizeof(*tlv);
+	switch (tag) {
+	case UNI_EVENT_ALL_STA_TX_RATE:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_TX_RATE_T);
+		break;
+	case UNI_EVENT_ALL_STA_TX_STAT:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_TX_STAT_T);
+		break;
+	case UNI_EVENT_ALL_STA_TXRX_ADM_STAT:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_TXRX_ADM_STAT_T);
+		break;
+	case UNI_EVENT_ALL_STA_TXRX_AIR_TIME:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_TXRX_AIR_TIME_T);
+		break;
+	case UNI_EVENT_ALL_STA_DATA_TX_RETRY_COUNT:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_DATA_TX_RETRY_COUNT_T);
+		break;
+	case UNI_EVENT_ALL_STA_TRX_MSDU_COUNT:
+		record_len = sizeof(struct UNI_EVENT_ONE_STA_TRX_MSDU_COUNT_T);
+		break;
+	default:
+		break;
+	}
+
+	if (record_len) {
+		if (sta_num > payload_len / record_len) {
+			reason = "station count exceeds payload";
+			goto invalid;
+		}
+
+		for (idx = 0; idx < sta_num; idx++) {
+			const UINT8 *record = tlv->au1AllStaContent + idx * record_len;
+
+			wcid = uni_event_all_sta_record_wcid(record);
+			if (!IS_WCID_VALID(pAd, wcid)) {
+				pr_warn_once("mt_wifi: dropping malformed ALL_STA event: tag=%u record=%u WCID=%u WTBL_MAX=%u\n",
+					(unsigned int)tag, (unsigned int)idx, (unsigned int)wcid,
+					(unsigned int)WTBL_MAX_NUM(pAd));
+				return FALSE;
+			}
+		}
+	}
+
+	*tag_out = tag;
+	*sta_num_out = sta_num;
+	*payload_len_out = payload_len;
+	return TRUE;
+
+invalid:
+	pr_warn_ratelimited("mt_wifi: dropping malformed ALL_STA event: %s\n", reason);
+	return FALSE;
+}
