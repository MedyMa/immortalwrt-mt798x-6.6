--- a/mt_wifi/common/cmm_sanity.c
+++ b/mt_wifi/common/cmm_sanity.c
@@ -2273,6 +2273,7 @@
 {
 	PFRAME_802_11 Fr = (PFRAME_802_11)Msg;
 	UCHAR		*Ptr;
+	UCHAR *ssid_ie = NULL;
 	UCHAR		eid = 0, eid_len = 0, *eid_data;
 #ifdef CONFIG_AP_SUPPORT
 #if defined(WSC_INCLUDED) || defined(EASY_CONFIG_SETUP)
@@ -2319,10 +2320,29 @@
 	COPY_MAC_ADDR(ProbeReqParam->Addr1, &Fr->Hdr.Addr1);
 #endif
 
-	if (Fr->Octet[0] != IE_SSID || Fr->Octet[1] > MAX_LEN_OF_SSID || Fr->Octet[1] > (MsgLen - LENGTH_802_11 - 2)) {
-		MTWF_DBG(NULL, DBG_CAT_TEST, CATTEST_SANITY, DBG_LVL_INFO,
-			"sanity fail - wrong SSID IE\n");
-		return FALSE;
+	{
+		UCHAR *ie_scan = Fr->Octet;
+		UINT scan_rem = MsgLen - LENGTH_802_11;
+		UINT ie_len;
+
+		/* Scan IEs to find SSID IE - some clients place vendor IEs first */
+		while (scan_rem >= 2) {
+			if (ie_scan[0] == IE_SSID) {
+				ssid_ie = ie_scan;
+				break;
+			}
+			ie_len = ie_scan[1] + 2;
+			if (ie_len < 2 || ie_len > scan_rem)
+				break;
+			ie_scan += ie_len;
+			scan_rem -= ie_len;
+		}
+
+		if (!ssid_ie || ssid_ie[1] > MAX_LEN_OF_SSID || ssid_ie[1] > (scan_rem - 2)) {
+			MTWF_DBG(NULL, DBG_CAT_TEST, CATTEST_SANITY, DBG_LVL_INFO,
+				"sanity fail - wrong SSID IE\n");
+			return FALSE;
+		}
 	}
 #ifdef EM_PLUS_SUPPORT
 	if (IS_BROADCAST_MAC_ADDR(ProbeReqParam->Addr1)) {
@@ -2373,8 +2393,8 @@
 	 * call that in certification case. Correct apidex passed in below API.
 	 */
 
-	ProbeReqParam->SsidLen = Fr->Octet[1];
-	NdisMoveMemory(ProbeReqParam->Ssid, &Fr->Octet[2], ProbeReqParam->SsidLen);
+	ProbeReqParam->SsidLen = ssid_ie[1];
+	NdisMoveMemory(ProbeReqParam->Ssid, ssid_ie + 2, ProbeReqParam->SsidLen);
 #ifdef CONFIG_AP_SUPPORT
 	COPY_MAC_ADDR(Addr1, &Fr->Hdr.Addr1);
 #ifdef WSC_AP_SUPPORT
