menu "Crypto Offload Configuration"
	depends on PACKAGE_kmod-crypto-eip && PACKAGE_kmod-mediatek_hnat

choice
	prompt "Crypto Offload Mode"
	default CRYPTO_OFFLOAD_INLINE
	help
	  This port supports inline XFRM packet offload only.

config CRYPTO_OFFLOAD_INLINE
	bool "Inline Mode"
	depends on TARGET_mediatek_mt7988 || TARGET_mediatek_filogic_a73 || TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r4 || TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r4-poe || TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r4-pro || TARGET_DEVICE_mediatek_filogic_DEVICE_mediatek_mt7988a-rfb || TARGET_DEVICE_mediatek_filogic_DEVICE_mediatek_mt7988d-rfb
	select PACKAGE_kmod-crypto-eip-inline
	select PACKAGE_kmod-crypto-eip-ddk
	select PACKAGE_kmod-crypto-eip-ddk-ksupport
	select PACKAGE_kmod-crypto-eip-ddk-ctrl
	select PACKAGE_kmod-crypto-eip-ddk-ctrl-app
	select PACKAGE_kmod-crypto-eip-ddk-engine
	select PACKAGE_crypto-eip-inline-fw
	select PACKAGE_strongswan
	select PACKAGE_strongswan-mod-kdf
	select PACKAGE_strongswan-default
endchoice

choice
	prompt "Crypto XFRM Offload Method"
	depends on CRYPTO_OFFLOAD_INLINE
	default CRYPTO_XFRM_OFFLOAD_MTK_PCE
	help
	  Use the MTK PCE classifier and CDRT tables for XFRM packet offload.

config CRYPTO_XFRM_OFFLOAD_MTK_PCE
	bool "Enable MTK PCE XFRM Offload"
endchoice

config CRYPTO_MTK_DDK_LOOKASIDE
	bool
	default n
	help
	  select y to enable ddk look-aside mode

config CRYPTO_OFFLOAD_INLINE_FLOWBLOCK
	bool
	depends on !PACKAGE_kmod-mediatek_hnat
	default n

endmenu
