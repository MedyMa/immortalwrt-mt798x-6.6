local cjson = require "cjson"
local nixio = require "nixio"
local fs = require "nixio.fs"
local l1parser = require "l1dat_parser"
local datconf = require "datconf"
local utils = require "mtwifi_utils"
local defs = require "mtwifi_defs"
local bandwidth = require "mtwifi_bandwidth"
local uci = require "uci"

local l1dat = l1parser.load_l1_profile(l1parser.L1_DAT_PATH)

local function command_ok(command)
    local result = os.execute(command)
    return result == 0 or result == true
end

function string:split(sep)
    local sep, fields = sep or ":", {}
    local pattern = string.format("([^%s]+)", sep)
    self:gsub(pattern, function(c) fields[#fields+1] = c end)
    return fields
end

function load_profile(path)
    local cfgs
    local cfgobj = datconf.openfile(path)
    if cfgobj then
        cfgs = cfgobj:getall()
        cfgobj:close()
    end

    return cfgs
end

function save_profile(cfgs, path)
    if not cfgs then
        return false
    end

    if not fs.chmod(path, "600") then
        nixio.syslog("err", "mtwifi-cfg: cannot set profile permissions on " .. path)
        return false
    end
    local datobj = datconf.openfile(path)
    if not datobj then return false end
    datobj:merge(cfgs)
    local result = datobj:commit()
    datobj:close()
    if result ~= 0 then
        nixio.syslog("err", "mtwifi-cfg: cannot save profile " .. path)
        return false
    end

    os.execute("sync")
    return true
end

local function whnat_groups()
    return l1parser.whnat_groups(l1dat)
end

local function whnat_group(dev)
    for _, group in ipairs(whnat_groups()) do
        if group.profiles[dev.profile_path] then return group end
    end
end

local function whnat_value(group)
    local cursor = uci.cursor()
    local value = cursor:get("wireless", group.master, "whnat")
    cursor:close()
    -- The existing LuCI flag defaults to enabled when its UCI option is absent.
    if value == nil or value == "" or value == true or value == 1 or value == "1" then
        return "1"
    elseif value == false or value == 0 or value == "0" then
        return "0"
    end
    nixio.syslog("err", "mtwifi-cfg: invalid WHNAT value for " .. group.master)
end

-- The netifd wrapper and boot service serialize all writers with mtwifi.lock.
-- Stage every DAT edit before the first write. datconf can truncate on failure,
-- so keep the exact original bytes, including comments, for every touched file.
local function stage_profile(changes, path, fields)
    local entry = changes[path]
    if not entry then
        local file = io.open(path, "rb")
        if not file then return false end
        local original = file:read("*a")
        file:close()
        if not original then return false end
        entry = { original = original, fields = {} }
        changes[path] = entry
    end
    for k, v in pairs(fields) do entry.fields[k] = v end
    return true
end

local function restore_profiles(changes)
    local restored = true
    for path, entry in pairs(changes) do
        if entry.written then
            local temporary = path .. ".mtwifi-restore"
            local file = io.open(temporary, "wb")
            local ok = file and fs.chmod(temporary, "600") and file:write(entry.original)
            if file and not file:close() then ok = false end
            if ok and os.rename(temporary, path) then
                entry.written = false
            else
                os.remove(temporary)
                nixio.syslog("err", "mtwifi-cfg: cannot restore " .. path)
                restored = false
            end
        end
    end
    return restored
end

local function commit_profiles(changes)
    for path, entry in pairs(changes) do
        entry.written = true
        if not save_profile(entry.fields, path) then
            restore_profiles(changes)
            return false
        end
    end
    return true
end

local function whnat_stage(changes, group, value, current_path, current_dats)
    local function stage(path)
        if path == current_path then
            current_dats.WHNAT = value
            return true
        end
        local dats = load_profile(path)
        return dats and (tostring(dats.WHNAT) == value or
            stage_profile(changes, path, { WHNAT = value }))
    end
    for path in pairs(group.profiles) do
        if not stage(path) then return false end
    end
    return stage(group.path)
end

local function whnat_apply(group, value)
    local applied, ok = {}, true
    for vif in utils.read_pipe("ls /sys/class/net"):gmatch("[^\n]+") do
        local dev = l1dat.ifname_ridx[vif]
        if dev and group.profiles[dev.profile_path] and not applied[dev.profile_path] and
            vif_status(vif) == "up" then
            local quoted = "'" .. vif:gsub("'", "'\\''") .. "'"
            local result = os.execute("iwpriv " .. quoted .. " set whnat_en=" .. value)
            if result == true or result == 0 then
                applied[dev.profile_path] = true
            else
                nixio.syslog("err", "mtwifi-cfg: WHNAT command failed on " .. vif)
                ok = false
            end
        end
    end
    return ok
end

function mtwifi_cfg_whnat()
    local changes, groups = {}, whnat_groups()
    for _, group in ipairs(groups) do
        group.value = whnat_value(group)
        local before = load_profile(group.path)
        if not before or not group.value or not whnat_stage(changes, group, group.value) then return false end
        group.previous = before.WHNAT
    end
    if not commit_profiles(changes) then return false end
    for i, group in ipairs(groups) do
        if not whnat_apply(group, group.value) then
            restore_profiles(changes)
            for j = 1, i do
                local previous = groups[j].previous
                if previous == "0" or previous == "1" then whnat_apply(groups[j], previous) end
            end
            return false
        end
    end
    return true
end

function diff_cfg(cfg1, cfg2)
    local diff = {}

    for k,v in pairs(cfg1) do
        if tostring(cfg2[k]) ~= tostring(cfg1[k]) then
            diff[k] = {cfg1[k] or "", cfg2[k] or ""}
        end
    end

    for k,v in pairs(cfg2) do
        if tostring(cfg2[k]) ~= tostring(cfg1[k]) then
            diff[k] = {cfg1[k] or "", cfg2[k] or ""}
        end
    end

    return diff
end

function vif_status(ifname)
    local flags = tonumber(utils.read_pipe("cat /sys/class/net/"..ifname.."/flags 2>/dev/null")) or 0
    if flags%2 == 1 then
        return "up"
    end
    return "down"
end

function is_dbdc_inited(ifname)
    local mac = utils.trim(utils.read_pipe("cat /sys/class/net/"..ifname.."/address 2>/dev/null"))
    if mac and mac ~= "00:00:00:00:00:00" then
        return true
    end
    return false
end

function ifup(ifname)
    if not ifname or not ifname:match("^[%w_%-]+$") then return false end
    if command_ok("ifconfig " .. ifname .. " up") then return true end
    nixio.syslog("err", "mtwifi-cfg: could not start " .. ifname)
    return false
end

function ifdown(ifname)
    if not ifname or not ifname:match("^[%w_%-]+$") then return false end
    if command_ok("ifconfig " .. ifname .. " down") then return true end
    nixio.syslog("err", "mtwifi-cfg: could not stop " .. ifname)
    return false
end

function cfg2dat(cfg)
    if type(cfg) == type(true) then
        if cfg then return 1 else return 0 end
    elseif type(cfg) == type(0) or type(cfg) == type("") then
        return cfg
    end
end

function set_dev_dat(dats, dat, cfg)
    if cfg ~= nil then
        dats[dat] = cfg2dat(cfg)
    end
end

function set_optional_dev_dat(dats, dat, cfg)
    if cfg ~= nil and cfg ~= "" then
        set_dev_dat(dats, dat, cfg)
    end
end

function set_dat(dats, apidx, dat, cfg)
    if cfg ~= nil then
        dats[dat] = utils.token_set(dats[dat], apidx, cfg2dat(cfg))
    end
end

function set_idx_dat(dats, apidx, dat, cfg)
    if cfg ~= nil then
        local key
        if apidx == 0 then
            key = dat
        else
            key = dat .. tostring(apidx)
        end
        dats[key] = cfg
    end
end


function vif_in_dev(vif, dev)
    if (vif == dev.main_ifname
        or string.match(vif, "^"..utils.esc(dev.ext_ifname).."[0-9]+$")
        or string.match(vif, "^"..utils.esc(dev.apcli_ifname).."[0-9]+$")
        or string.match(vif, "^"..utils.esc(dev.wds_ifname).."[0-9]+$")
        or string.match(vif, "^"..utils.esc(dev.mesh_ifname).."[0-9]+$")) then
        return true
    else
        return false
    end
end

function vif_is_apcli(vif, dev)
    if (string.match(vif, "^"..utils.esc(dev.apcli_ifname).."[0-9]+$")) then
        return true
    else
        return false
    end
end

function is_ax_mode(cfg)
    if not cfg.config.htmode then
        return false
    end
    if string.sub(cfg.config.htmode,1,2) == "HE" then
        return true
    end
    return false
end

function is_be_mode(cfg)
    if not cfg.config.htmode then
        return false
    end
    if string.sub(cfg.config.htmode,1,3) == "EHT" then
        return true
    end
    return false
end

function vif_count(cfg)
    local vif_num = 0
    local ap_num = 0
    local apcli_num = 0

    for k,v in pairs(cfg.interfaces) do
        vif_num = vif_num + 1
        if v.config.mode == "ap" then
            ap_num = ap_num + 1
        elseif v.config.mode == "sta" then
            apcli_num = apcli_num + 1
        end
    end

    return vif_num, ap_num, apcli_num
end

local function ordered_vifs(cfg)
    local interfaces = cfg.interfaces or {}
    local keys = {}
    for key in pairs(interfaces) do
        keys[#keys + 1] = key
    end
    -- netifd uses zero-based keys in 24.10 and padded, one-based keys in 25.12.
    table.sort(keys, function(a, b)
        local na, nb = tonumber(a), tonumber(b)
        if na and nb then
            if na ~= nb then return na < nb end
        elseif na then
            return true
        elseif nb then
            return false
        end
        return tostring(a) < tostring(b)
    end)

    local vifs = {}
    for _, key in ipairs(keys) do
        vifs[#vifs + 1] = interfaces[key]
    end
    return vifs
end

local function mtwifi_cfg_foreach_vif(cfg, mode, func)
    for _, vif in ipairs(ordered_vifs(cfg)) do
        if vif.config.mode == mode and not defs.disabled(vif.config.disabled) then func(vif) end
    end
end

function __apcli_auto_connect(ifname)
    __exec_iwpriv_cmd(ifname, "ApCliEnable", "1")
    __exec_iwpriv_cmd(ifname, "ApCliAutoConnect", "3")
end

function mtwifi_up(devname, cfg, restore_vifs, is_dbdc)
    nixio.syslog("info", "mtwifi-cfg: start "..devname)
    local dev = l1dat.devname_ridx[devname]
    if not dev then return false end

    if is_dbdc then
        local dbdc_main_dev = l1dat.devname_ridx[dev.INDEX .. "_1_1"]
        if not dbdc_main_dev then return false end
        local dbdc_main_ifname = dbdc_main_dev.main_ifname

        if not is_dbdc_inited(dbdc_main_ifname) then
            nixio.syslog("info", "mtwifi-cfg: dbdc card init...")
            if not ifup(dbdc_main_ifname) then return false end
            utils.sleep(1)
            if not ifdown(dbdc_main_ifname) then return false end
        end

        if restore_vifs and devname ~= cfg.device then
            -- restart ap vif
            for _,vif in ipairs(restore_vifs) do
                if vif_in_dev(vif, dev) and (not vif_is_apcli(vif, dev)) then
                    nixio.syslog("info", "mtwifi-cfg: restore ap vif: "..vif)
                    if not ifup(vif) then return false end
                end
            end
            -- restart apcli vif
            for _,vif in ipairs(restore_vifs) do
                if vif_is_apcli(vif, dev) then
                    nixio.syslog("info", "mtwifi-cfg: restore apcli vif: "..vif)
                    if not ifup(vif) then return false end
                    __apcli_auto_connect(vif)
                end
            end
            return true
        end
    end

    for _, mode in ipairs({"ap", "sta"}) do
        for _, v in ipairs(ordered_vifs(cfg)) do
            if v.config.mode == mode and not defs.disabled(v.config.disabled) and not ifup(v.mtwifi_ifname) then
                return false
            end
        end
    end
    return true
end

local function stop_dot1x(dev)
    local path = "/var/run/8021xd_" .. dev.main_ifname .. ".pid"
    local file = io.open(path)
    if not file then return true end
    local pid = tonumber(file:read("*l"))
    file:close()
    local function running()
        return pid and pid > 1 and fs.readlink("/proc/" .. pid .. "/exe") == "/usr/bin/8021xd" and
            (fs.readfile("/proc/" .. pid .. "/cmdline") or ""):find("-i%z" .. utils.esc(dev.main_ifname) .. "%z")
    end
    if running() then
        nixio.kill(pid, 15)
        for i = 1, 20 do
            if not running() then break end
            nixio.nanosleep(0, 100000000)
        end
        if running() then return false end
    end
    os.remove(path)
    return true
end

function mtwifi_down(devname, cfg)
    nixio.syslog("info", "mtwifi-cfg: stop "..devname)
    local dev = l1dat.devname_ridx[devname]
    local reset_vifs = {}

    if not dev then return reset_vifs, false end

    local ok = stop_dot1x(dev)
    for _,vif in ipairs(string.split(utils.read_pipe("ls /sys/class/net"), "\n")) do
        if (vif_status(vif) == "up" and vif_in_dev(vif, dev)) then
            nixio.syslog("info", "mtwifi-cfg: down vif: "..vif)
            if not ifdown(vif) then ok = false end
            if cfg and devname ~= cfg.device then
                reset_vifs[#reset_vifs+1] = vif
            end
        end
    end
    return reset_vifs, ok
end

local function vendor_module_order()
    local allowed = { mt_wifi = true, mtk_hwifi = true, connac_if = true,
        mtk_pci = true, mtk_wed = true, mt7990 = true, mt7991 = true,
        mt7992 = true, mt7993 = true, mtk_warp = true, mtk_warp_proxy = true,
        debugger_wifi = true }
    local order, visited = {}, {}
    local function visit(name)
        if not allowed[name] then error("wireless module has an unrelated consumer") end
        if visited[name] then return end
        visited[name] = true
        local entries = fs.dir("/sys/module/" .. name .. "/holders")
        if entries then
            for holder in entries do
                if holder ~= "." and holder ~= ".." then visit(holder) end
            end
        end
        order[#order + 1] = name
    end
    visit("mt_wifi")
    return order
end

function mtwifi_reinstall(restore, order)
    local root_changed = false
    local function failed()
        if restore and not restore() then
            nixio.syslog("err", "mtwifi-cfg: profile recovery failed")
        end
        if root_changed then
            for _, name in ipairs(order) do
                if utils.exists("/sys/module/" .. name) and not command_ok("rmmod " .. name) then break end
            end
        end
        for index = #order, 1, -1 do
            if not command_ok("modprobe " .. order[index]) then
                nixio.syslog("err", "mtwifi-cfg: driver recovery failed")
                break
            end
        end
        return false
    end
    for _, name in ipairs(order) do
        if utils.exists("/sys/module/" .. name) then
            if not command_ok("rmmod " .. name) then return failed() end
            if name == "mt_wifi" then root_changed = true end
        end
    end
    for index = #order, 1, -1 do
        if not command_ok("modprobe " .. order[index]) then return failed() end
    end
    return true
end

local function restart_other_radios(current)
    local cursor = uci.cursor()
    cursor:foreach("wireless", "wifi-device", function(section)
        local name = section[".name"]
        if name ~= current and section.type == "mtwifi" and l1dat.devname_ridx[name] and
            tostring(section.disabled) ~= "1" and name:match("^[%w_]+$") then
            local request = cjson.encode({ device = name })
            local quoted = "'" .. request:gsub("'", "'\\''") .. "'"
            local command = "(ubus call network.wireless down " .. quoted ..
                "; ubus call network.wireless up " .. quoted .. ") </dev/null >/dev/null 2>&1 &"
            if not command_ok(command) then
                nixio.syslog("err", "mtwifi-cfg: could not restart sibling radio")
            end
        end
    end)
    cursor:close()
end

function __exec_iwpriv_cmd(ifname, key, val)
    local cmd = string.format("iwpriv %s set %s=%s", ifname, key, tostring(val))
    nixio.syslog("info", "mtwifi-cfg: iwpriv cmd: "..cmd)
    os.execute(cmd)
end

function mtwifi_cfg_iwpriv_hook(cfg)
    local ap_hook = function(v)
        if (not v.config.disabled) and v.mtwifi_ifname then
            local vif = v.mtwifi_ifname
            for k, j in pairs(defs.iwpriv_ap_cfgs) do
                __exec_iwpriv_cmd(vif, j[1], v.config[k] or j[2])
            end
        end
    end

    local apcli_hook = function(v)
        __apcli_auto_connect(v.mtwifi_ifname)
    end

    mtwifi_cfg_foreach_vif(cfg, "ap", ap_hook)
    mtwifi_cfg_foreach_vif(cfg, "sta", apcli_hook)
end

local function set_chip_cfg(cfg, dats, init_whnat, changes)
    if not defs.disabled(cfg.config.dbdc_main) then return true end
    local shared = {}
    for option, field in pairs(defs.chip_cfgs) do
        local key = field[1]
        if key ~= "WHNAT" or not init_whnat then
            dats[key] = field[2]
            set_dev_dat(dats, key, cfg.config[option])
            shared[key] = dats[key]
        end
    end
    local dev = l1dat.devname_ridx[cfg.device]
    for _, radio in pairs(l1dat.devname_ridx) do
        if radio.profile_path ~= dev.profile_path and radio.INDEX == dev.INDEX and radio.mainidx == dev.mainidx then
            local current = load_profile(radio.profile_path)
            if not current then return false end
            for key, value in pairs(shared) do
                if tostring(current[key]) ~= tostring(value) and
                    not stage_profile(changes, radio.profile_path, { [key] = value }) then return false end
            end
        end
    end
    return true
end

local function mld_group(config)
    local value = config.mldgroup

    if value ~= nil and value ~= "" then
        local group = tonumber(value)
        if not group or group < 0 or group > 16 or group ~= math.floor(group) then
            return nil, false
        end
        return group, true
    end

    value = config.mlo
    if value == nil then
        -- New and unset AP configuration defaults to MLO disabled even when
        -- a vendor profile template contains a nonzero MldGroup token.
        return 0, true
    elseif value == true or value == 1 or value == "1" then
        return 1, true
    elseif value == false or value == 0 or value == "0" then
        return 0, true
    end

    return nil, false
end

local function mld_group_with_profile(iface, profile, apidx)
    local group, valid = mld_group(iface)
    if group ~= nil or not valid then
        return group, valid
    end

    local token = utils.token_get(profile and profile.MldGroup, apidx, "0")
    return mld_group({ mldgroup = token })
end

local function mld_legacy_boolean(config)
    return (config.mldgroup == nil or config.mldgroup == "") and
        (config.mlo == true or config.mlo == 1 or config.mlo == "1")
end

local function mld_bool(value)
    if value == true or value == 1 or value == "1" or value == "true" or value == "yes" then
        return "1"
    elseif value == false or value == 0 or value == "0" or value == "false" or value == "no" or value == nil or value == "" then
        return "0"
    end
    return tostring(value)
end

local function mld_disabled(value)
    return mld_bool(value) == "1"
end

local function mld_eht_mode(value)
    local modes = {
        EHT20 = true, EHT40 = true, EHT80 = true, EHT80_80 = true,
        EHT160 = true, EHT320 = true, ["EHT320-1"] = true, ["EHT320-2"] = true
    }
    return type(value) == "string" and modes[value] == true
end

local function mld_writer_signature(iface)
    local security = defs.security(iface)
    if not security then return nil end
    local signature = defs.security_signature(security)
    signature[#signature + 1] = tostring(iface.ssid or "")
    return signature
end

local function add_mld_member(groups, group, signature, legacy_boolean)
    if group and group > 0 and signature then
        local members = groups[group] or {}
        members[#members + 1] = { signature = signature, legacy_boolean = legacy_boolean }
        groups[group] = members
    end
end

local function validate_mld_groups(cfg)
    local groups, affected, other_aps = {}, {}, {}
    local disabled_legacy_groups = {}
    local cursor = uci.cursor()
    local current_device = cfg.device
    local current_device_type = cursor:get("wireless", current_device, "type")

    if current_device_type ~= "mtwifi" then
        return true
    end

    local current_dev = l1dat.devname_ridx[current_device]
    local current_profile = current_dev and load_profile(current_dev.profile_path) or {}
    local interfaces = cfg.interfaces or {}
    local config = cfg.config or {}
    local htmode = config.htmode or cursor:get("wireless", current_device, "htmode")
    local disabled_value = config.disabled
    if disabled_value == nil then
        disabled_value = cursor:get("wireless", current_device, "disabled")
    end
    local radio_disabled = mld_disabled(disabled_value)
    local apidx = 0

    -- The writer walks netifd's numeric interface keys and increments the DAT
    -- slot only for APs. Resolve an omitted option from that exact profile slot.
    for _, item in ipairs(ordered_vifs(cfg)) do
        local iface = item and (item.config or item)
        if iface and iface.mode == "ap" then
            apidx = apidx + 1
            local group, valid = mld_group_with_profile(iface, current_profile, apidx)
            if not valid then
                return false
            end

            local active = not radio_disabled and not mld_disabled(iface.disabled) and mld_eht_mode(htmode)
            if active and group and group > 0 then
                affected[group] = true
                add_mld_member(groups, group, mld_writer_signature(iface), mld_legacy_boolean(iface))
            end
        end
    end

    -- Other radios are not part of the current netifd JSON. Their persisted
    -- UCI AP order corresponds to compact AP BSSID slots; use their DAT token
    -- when group aliases are absent, then compare the values this writer maps.
    cursor:foreach("wireless", "wifi-iface", function(iface)
        local device = iface.device
        if device and device ~= current_device and iface.mode == "ap" and
            cursor:get("wireless", device, "type") == "mtwifi" and
            not mld_disabled(cursor:get("wireless", device, "disabled")) then
            local list = other_aps[device] or {}
            -- Disabled APs still occupy their vendor DAT BSSID slot. Preserve
            -- them in this ordered list, then exclude them only from members.
            list[#list + 1] = iface
            other_aps[device] = list
        end
    end)

    for device, aps in pairs(other_aps) do
        local dev = l1dat.devname_ridx[device]
        local profile = dev and load_profile(dev.profile_path) or {}
        local other_htmode = cursor:get("wireless", device, "htmode")
        if mld_eht_mode(other_htmode) then
            for slot, iface in ipairs(aps) do
                if not mld_disabled(iface.disabled) then
                    local group, valid = mld_group_with_profile(iface, profile, slot)
                    if valid and group and affected[group] then
                        add_mld_member(groups, group, mld_writer_signature(iface), mld_legacy_boolean(iface))
                    end
                end
            end
        end
    end

    for group in pairs(affected) do
        local members = groups[group]
        if members and #members > 1 then
            local first = table.concat(members[1].signature, "\0")
            local mismatch, legacy_only = false, true
            for index = 2, #members do
                if table.concat(members[index].signature, "\0") ~= first then
                    mismatch = true
                end
            end
            for _, member in ipairs(members) do
                if not member.legacy_boolean then legacy_only = false end
            end
            if mismatch and legacy_only then
                -- Keep independent AP names/security, but never advertise an
                -- inconsistent legacy group as one MLD. Explicit managed
                -- numeric groups retain the strict validation below.
                disabled_legacy_groups[group] = true
            elseif mismatch then
                return false
            end
        end
    end

    if next(disabled_legacy_groups) then
        nixio.syslog("warning", "mtwifi-cfg: disabling inconsistent legacy MLO groups; independent AP settings are preserved")
    end

    return true, disabled_legacy_groups
end

local function valid_eht_restricted_twt(value)
    return value == nil or value == "" or value == 0 or value == "0" or value == 1 or value == "1"
end

local function valid_mac(value)
    return type(value) == "string" and value:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") ~= nil
end

local function acl(config)
    local list, seen = {}, {}
    local function add(mac)
        if not valid_mac(mac) then return false end
        mac = mac:lower()
        if seen[mac] then return true end
        if #list >= defs.max_acl_entry then return false end
        list[#list + 1], seen[mac] = mac, true
        return true
    end
    if config.macfilter ~= "allow" and config.macfilter ~= "deny" then return "" end
    if config.maclist ~= nil and type(config.maclist) ~= "table" then return nil end
    for _, mac in ipairs(config.maclist or {}) do
        if not add(mac) then return nil end
    end
    if config.macfile and config.macfile ~= "" then
        if type(config.macfile) ~= "string" or config.macfile:sub(1, 1) ~= "/" or
            fs.stat(config.macfile, "type") ~= "reg" then return nil end
        local file = io.open(config.macfile, "r")
        if not file then return nil end
        local contents = file:read(16385)
        file:close()
        if contents and #contents > 16384 then return nil end
        for line in ((contents or "") .. "\n"):gmatch("([^\n]*)\n") do
            local mac = utils.trim(line:gsub("#.*$", ""))
            if mac ~= "" and not add(mac) then return nil end
        end
    end
    return table.concat(list, ";")
end

local function validate_vifs(cfg, dev)
    local settings = {}
    for _, v in ipairs(ordered_vifs(cfg)) do
        if type(v) ~= "table" or type(v.config) ~= "table" then return nil, "INVALID_INTERFACE" end
        local config = v.config
        local mode = config.mode
        local disabled = defs.disabled(config.disabled)
        local ifname = v.mtwifi_ifname
        local prefix = mode == "ap" and dev.ext_ifname or dev.apcli_ifname
        if mode ~= "ap" and mode ~= "sta" then return nil, "UNSUPPORTED_INTERFACE_MODE" end
        if not disabled and (type(ifname) ~= "string" or #ifname > 15 or not prefix or
            not ifname:match("^" .. utils.esc(prefix) .. "%d+$")) then
            return nil, "INVALID_INTERFACE_NAME"
        end

        local security, err = defs.security(config)
        local ssid = config.ssid
        if type(ssid) ~= "string" or #ssid == 0 or #ssid > 32 or ssid:find("%c") then
            ssid, err = "", "INVALID_SSID"
        end
        if security and cfg.config.band == "6g" and security.auth ~= "WPA3PSK" and security.auth ~= "OWE" then
            err = "SIX_GHZ_REQUIRES_SAE_OR_OWE"
        end
        for _, field in ipairs({"macaddr", "bssid"}) do
            if config[field] and config[field] ~= "" and not valid_mac(config[field]) then
                if not disabled then return nil, "INVALID_MAC_ADDRESS" end
                config[field] = nil
            end
        end
        local maclist = ""
        if mode == "ap" and not disabled then
            for field in pairs(defs.iwpriv_ap_cfgs) do
                local value = config[field]
                if value ~= nil and value ~= "" then
                    local threshold = tonumber(value)
                    if not threshold or threshold % 1 ~= 0 or threshold < -100 or threshold > 0 then
                        return nil, "INVALID_RSSI_THRESHOLD"
                    end
                    config[field] = threshold
                else
                    config[field] = nil
                end
            end
            maclist = acl(config)
            if not maclist then return nil, "INVALID_ACL" end
        end
        if err and not disabled then return nil, err end
        settings[v] = { security = err and defs.security({}) or security, ssid = ssid, maclist = maclist }
    end
    return settings
end

function mtwifi_cfg_setup(argv)
    local decoded, cfg = pcall(cjson.decode, argv)
    if not decoded or type(cfg) ~= "table" or type(cfg.config) ~= "table" or
        type(cfg.interfaces) ~= "table" or not l1dat then return false end

    local devname = cfg.device
    local dev = l1dat.devname_ridx[devname]

    if not dev then return false end

    local device_band = l1parser.device_band(dev)
    local radio = cfg.config
    if radio.band == nil or radio.band == "" or radio.band == "auto" then radio.band = device_band end
    if radio.band == "2.4g" then radio.band = "2g" end
    if device_band and radio.band ~= device_band then
        nixio.syslog("err", "mtwifi-cfg: RADIO_BAND_MISMATCH")
        return false
    end
    if radio.channel == nil or radio.channel == "" or tostring(radio.channel) == "0" then radio.channel = "auto" end
    local country = radio.country
    local region
    if type(country) == "string" and country ~= "" then
        country = country:upper()
        region = defs.country_region(country, radio.band)
        if region == nil then
            nixio.syslog("err", "mtwifi-cfg: INVALID_COUNTRY")
            return false
        end
    end
    local vifs, vif_error = validate_vifs(cfg, dev)
    if not vifs then
        nixio.syslog("err", "mtwifi-cfg: " .. vif_error)
        return false
    end

    local whnat = whnat_group(dev)

    if not valid_eht_restricted_twt(cfg.config.eht_restricted_twt) then
        nixio.syslog("err", "mtwifi-cfg: invalid EHT Restricted TWT value")
        return false
    end

    local valid_mld, disabled_legacy_groups = validate_mld_groups(cfg)
    if not valid_mld then
        nixio.syslog("err", "mtwifi-cfg: MLO group requires matching SSID and security settings")
        return false
    end

    local profile = dev.profile_path

    local dats = load_profile(profile)
    if not dats then
        nixio.syslog("err", "mtwifi-cfg: profile ".. profile .. "open failed")
        return false
    end
    local dats_orig = load_profile(profile)
    if not dats_orig then return false end
    local changes = {}
    local function restore_profile() return restore_profiles(changes) end
    set_optional_dev_dat(dats, "Vht1024QamSupport", cfg.config.vht_1024)
    set_optional_dev_dat(dats, "TxBurst", cfg.config.tx_burst)
    local is_5g = cfg.config.band == "5g"
    set_optional_dev_dat(dats, "IEEE80211H", is_5g and cfg.config.doth or nil)
    set_optional_dev_dat(dats, "TxPreamble", cfg.config.tx_preamble)
    set_optional_dev_dat(dats, "DfsEnable", is_5g and cfg.config.dfs or nil)

    local vif_num, bssid_num, apcli_num = vif_count(cfg)

    if vif_num == 0 then
        local _, stopped = mtwifi_down(devname)
        return stopped
    end
    if bssid_num > defs.max_mbssid then
        nixio.syslog("err", "mtwifi-cfg: too many vifs!")
        return false
    end
    if apcli_num > 1 then
        nixio.syslog("err", "mtwifi-cfg: only support one apcli vif!")
        return false
    end

    -- Changing BssidNum reloads the shared driver. Keep the vendor allocation
    -- (two on BE14 6 GHz) unless the requested APs need more slots.
    dats.BssidNum = math.max(1, bssid_num, tonumber(dats_orig.BssidNum) or 4)

    -- HeLdpc is parsed as one semicolon-delimited value per BSSID. Only
    -- replace the profile when the radio option is explicitly configured.
    if cfg.config.he_ldpc ~= nil and cfg.config.he_ldpc ~= "" then
        local he_ldpc = {}
        local he_ldpc_value = tostring(cfg.config.he_ldpc)
        for i = 1, tonumber(dats.BssidNum) do
            he_ldpc[i] = he_ldpc_value
        end
        dats.HeLdpc = table.concat(he_ldpc, ";")
    end


    -- setup wireless mode
    if type(cfg.config.htmode) ~= type("") then
        nixio.syslog("err", "mtwifi-cfg: invalid htmode!")
        return false
    end

    if region ~= nil then
        dats.CountryCode = country
        dats[radio.band == "2g" and "CountryRegion" or "CountryRegionABand"] = region
    end
    local bandwidth_ok, bandwidth_err, WirelessMode = bandwidth.apply(cfg.config, dats)
    if not bandwidth_ok then
        nixio.syslog("err", "mtwifi-cfg: " .. bandwidth_err .. "!")
        return false
    end
    local channel_ok, channel_error = bandwidth.set_channel(cfg.config, dats)
    if not channel_ok then
        nixio.syslog("err", "mtwifi-cfg: " .. channel_error)
        return false
    end

    if is_ax_mode(cfg) or is_be_mode(cfg) then
        if radio.bss_color ~= nil and radio.bss_color ~= "" then
            local color = tonumber(radio.bss_color)
            if not color or color ~= math.floor(color) or (color ~= 255 and (color < 1 or color > 63)) then
                nixio.syslog("err", "mtwifi-cfg: invalid BSS color")
                return false
            end
            dats.BSSColorValue = color
        end
        local sr = cfg2dat(radio.sre_enable)
        if sr ~= nil and sr ~= "" then
            sr = tonumber(sr)
            if sr ~= 0 and sr ~= 1 then
                nixio.syslog("err", "mtwifi-cfg: invalid spatial reuse value")
                return false
            end
            dats.SREnable = sr
        end
    end

    -- setup apcli
    dats.ApCliEnable = 0
    dats.ApCliSsid = ""
    dats.ApCliBssid = ""
    dats.MACRepeaterEn = 0
    dats.ApcliMacAddress = ""
    dats.ApCliAuthMode = ""
    dats.ApCliEncrypType = ""
    dats.ApCliWPAPSK = ""
    dats.ApCliPMFMFPC = 0
    dats.ApCliPMFMFPR = 0
    dats.ApCliPMFSHA256 = 0
    dats.ApCliPweMethod = 0

    for _, v in ipairs(ordered_vifs(cfg)) do
        if v.config.mode == "sta" then
            local security = vifs[v].security
            local enabled = not defs.disabled(v.config.disabled)
            dats.ApCliEnable = enabled and 1 or 0
            dats.ApCliSsid = vifs[v].ssid
            dats.ApCliBssid = v.config.bssid or ""
            dats.MACRepeaterEn = enabled and defs.disabled(v.config.mac_repeater) and 1 or 0
            dats.ApcliMacAddress = v.config.macaddr or (dats.MacAddress_Default or "")
            dats.ApCliAuthMode = security.auth
            dats.ApCliEncrypType = security.cipher
            dats.ApCliWPAPSK = security.key
            dats.ApCliPMFMFPC = security.pmf > 0 and 1 or 0
            dats.ApCliPMFMFPR = security.pmf == 2 and 1 or 0
            dats.ApCliPweMethod = cfg.config.band == "6g" and 2 or 0
            break
        end
    end

    -- The profile remains authoritative for omitted optional controls. An
    -- explicit 802.11h disable clears its dependent DFS settings; otherwise
    -- only explicitly supplied DFS / Zero-Wait values replace the profile.
    if is_5g and cfg.config.doth ~= nil and cfg.config.doth ~= "" and mld_bool(cfg.config.doth) == "0" then
        dats.DfsEnable = 0
        dats.DfsZeroWait = 0
        dats.DfsDedicatedZeroWait = 0
        dats.DfsZeroWaitDefault = 0
    else
        if is_5g and cfg.config.dfs ~= nil and cfg.config.dfs ~= "" then
            dats.DfsEnable = cfg2dat(cfg.config.dfs)
        end
        if is_5g and cfg.config.zw_dfs ~= nil and cfg.config.zw_dfs ~= "" then
            if mld_bool(cfg.config.zw_dfs) == "1" and mld_bool(dats.IEEE80211H) == "1" and
                mld_bool(dats.DfsEnable) == "1" then
                dats.DfsZeroWait = (dats.MACRepeaterEn == 1) and 0 or 1
                dats.DfsDedicatedZeroWait = 2
                dats.DfsZeroWaitDefault = 1
            else
                dats.DfsZeroWait = 0
                dats.DfsDedicatedZeroWait = 0
                dats.DfsZeroWaitDefault = 0
            end
        end
    end

    -- setup chip cfgs
    if not set_chip_cfg(cfg, dats, whnat ~= nil, changes) then return false end

    -- setup other dev cfgs
    if cfg.config.txpower and cfg.config.txpower < 100 then
        dats.PERCENTAGEenable = 1
        dats.TxPower = cfg.config.txpower
    else
        dats.PERCENTAGEenable = 0
        dats.TxPower = 100
    end

    if cfg.config.mu_beamformer then
        dats.ETxBfEnCond = 1
        if dats.ApCliEnable == 1 then
            dats.MUTxRxEnable = 3
        else
            dats.MUTxRxEnable = 1
        end
        dats.ITxBfEn = 1
    else
        dats.ETxBfEnCond = 0
        dats.MUTxRxEnable = 0
        dats.ITxBfEn = 0
    end

    if (is_ax_mode(cfg) or is_be_mode(cfg)) and cfg.config.twt then
        dats.TWTSupport = cfg.config.twt
    else
        dats.TWTSupport = 0
    end

    -- MldGroup is intentionally excluded: an unset UI value preserves the
    -- profile token, while an explicit group is written in the AP loop below.
    for k,v in pairs(defs.vif_cfgs) do
        if k ~= "MldGroup" then
            dats[k] = ""
            for i = 1, bssid_num do
                dats[k] = utils.token_set(dats[k], i, v)
            end
        end
    end

    for k,v in pairs(defs.vif_cfgs_idx) do
        for i = 1, defs.max_mbssid do
            dats[k..tostring(i)] = ""
        end
        for i = 1, bssid_num do
            dats[k..tostring(i)] = v
        end
    end

    for _, vif_table in ipairs({defs.vif_mac, defs.vif_acl}) do
        for k, v in pairs(vif_table) do
            if k == "MacAddress" then
                for i = 1, bssid_num-1 do
                    dats[k..tostring(i)] = v
                end
                if bssid_num < defs.max_mbssid then
                    for i = bssid_num, defs.max_mbssid-1 do
                        dats[k..tostring(i)] = ""
                    end
                end
            else
                for i = 0, bssid_num-1 do
                    dats[k..tostring(i)] = v
                end
                if bssid_num < defs.max_mbssid then
                    for i = bssid_num, defs.max_mbssid-1 do
                        dats[k..tostring(i)] = ""
                    end
                end
            end
        end
    end

    -- setup vif cfgs
    local eap_bridges, ownip = {}, nil
    local apidx = 1
    for _, v in ipairs(ordered_vifs(cfg)) do
        if v.config.mode == "ap" then
            local settings = vifs[v]
            local security = settings.security
            if security.server and not defs.disabled(v.config.disabled) then
                local bridge = v.bridge or v.mtwifi_ifname
                if not bridge or #bridge > 15 or not bridge:match("^[%w_.-]+$") then return false end
                local ip = v.config.ownip or utils.read_pipe("ip -4 route get " .. security.server):match(" src ([%d.]+)")
                if not ip or (ownip and ip ~= ownip) then
                    nixio.syslog("err", "mtwifi-cfg: RADIUS source address unavailable or inconsistent")
                    return false
                end
                ownip = ip
                eap_bridges[bridge] = true
                set_dat(dats, apidx, "RADIUS_Server", security.server)
                set_dat(dats, apidx, "RADIUS_Port", security.port)
                set_idx_dat(dats, apidx, "RADIUS_Key", security.secret)
                -- WPA2 selects the external authenticator. IEEE8021X enables dynamic WEP in WEXT.
            end
            set_idx_dat(dats, apidx, "SSID", settings.ssid)
            set_idx_dat(dats, apidx, "WPAPSK", security.key)
            set_dat(dats, apidx, "NoForwarding", defs.disabled(v.config.isolate) and 1 or 0)
            set_dat(dats, apidx, "HideSSID", v.config.hidden)
            -- The legacy parser consumes one boolean token per AP BSSID.
            -- Keep the vendor profile untouched when this EHT-only control is unset.
            if cfg.config.eht_restricted_twt ~= nil and cfg.config.eht_restricted_twt ~= "" then
                set_dat(dats, apidx, "EHT_ApRestrictedTwt", cfg.config.eht_restricted_twt)
            end
            local group = mld_group(v.config)
            if group and disabled_legacy_groups and disabled_legacy_groups[group] and mld_legacy_boolean(v.config) then
                group = 0
            end
            if group ~= nil then
                set_dat(dats, apidx, "MldGroup", group)
            end
            local effective_group = group
            if effective_group == nil then
                effective_group = tonumber(utils.token_get(dats.MldGroup, apidx, "0"))
            end
            if effective_group == 0 then
                if apidx == 1 then
                    dats.MacAddress = v.config.macaddr or (dats.MacAddress_Default or "")
                else
                    set_idx_dat(dats, apidx - 1, "MacAddress", v.config.macaddr or (dats.MacAddress_Default or ""))
                end
            end
            set_dat(dats, apidx, "WmmCapable", v.config.wmm)
            set_dat(dats, apidx, "RRMEnable", v.config.ieee80211k)
            set_dat(dats, apidx, "RekeyInterval", v.config.wpa_group_rekey)
            set_dat(dats, apidx, "HT_AMSDU", v.config.amsdu)
            set_dat(dats, apidx, "HT_AutoBA", v.config.autoba)
            set_dat(dats, apidx, "APSDCapable", v.config.uapsd)
            set_dat(dats, apidx, "RTSThreshold", v.config.rts)
            set_dat(dats, apidx, "FragThreshold",v.config.frag)
            set_dat(dats, apidx, "DtimPeriod",v.config.dtim_period)
            set_dat(dats, apidx, "WirelessMode", WirelessMode)
            set_dat(dats, apidx, "WNMEnable", v.config.bss_transition)

            if is_be_mode(cfg) then
                set_dat(dats, apidx, "PpMuMimoDlEnable", not v.config.mumimo_dl and 0 or 1)
                set_dat(dats, apidx, "PpMuMimoUlEnable", not v.config.mumimo_ul and 0 or 1)
                set_dat(dats, apidx, "PpOfdmaDlEnable", v.config.ofdma_dl)
                set_dat(dats, apidx, "PpOfdmaUlEnable", v.config.ofdma_ul)
                set_dat(dats, apidx, "HT_BAWinSize", 1024)
            elseif is_ax_mode(cfg) then
                set_dat(dats, apidx, "MuMimoDlEnable", not v.config.mumimo_dl and 0 or 1)
                set_dat(dats, apidx, "MuMimoUlEnable", not v.config.mumimo_ul and 0 or 1)
                set_dat(dats, apidx, "MuOfdmaDlEnable", v.config.ofdma_dl)
                set_dat(dats, apidx, "MuOfdmaUlEnable", v.config.ofdma_ul)
                set_dat(dats, apidx, "HT_BAWinSize", 256)
            else
                set_dat(dats, apidx, "HT_BAWinSize", 64)
            end

            local policy = ({ allow = 1, deny = 2 })[v.config.macfilter] or 0
            dats["AccessPolicy" .. (apidx - 1)] = policy
            dats["AccessControlList" .. (apidx - 1)] = settings.maclist

            local authmode = security.auth
            set_dat(dats, apidx, "AuthMode", authmode)
            set_dat(dats, apidx, "EncrypType", security.cipher)
            set_dat(dats, apidx, "PMFMFPC", security.pmf > 0 and 1 or 0)
            set_dat(dats, apidx, "PMFMFPR", security.pmf == 2 and 1 or 0)

            if cfg.config.band == "6g" then
                -- SAE hash-to-element and PMF are required on 6 GHz.
                set_dat(dats, apidx, "PweMethod", 2)
            end

            if not (authmode == "OPEN" or authmode == "OWE") then
                set_dat(dats, apidx, "RekeyMethod", "TIME")
            end

            apidx = apidx + 1
        end
    end

    if ownip then
        local names = {}
        for name in pairs(eap_bridges) do names[#names + 1] = name end
        table.sort(names)
        dats.own_ip_addr = ownip
        dats.EAPifname = table.concat(names, ";")
        dats.PreAuthifname = dats.EAPifname
    end
    local reinstall_wifidrv = false
    local whnat_enabled
    if whnat then
        whnat_enabled = whnat_value(whnat)
        if not whnat_enabled or not whnat_stage(changes, whnat, whnat_enabled, profile, dats) then
            return false
        end
    end
    local cfg_diff = diff_cfg(dats_orig, dats)

    for _,v in pairs(defs.reinstall_cfgs) do
        local changed = cfg_diff[v] ~= nil
        -- Collapsing a template's all-disabled WDS tokens (0;0 -> 0) does
        -- not change its state and must not unload the WiFi7 module stack.
        if whnat and changed and v == "WdsEnable" and
            tostring(dats_orig[v]):match("^0[0;]*$") and tostring(dats[v]):match("^0[0;]*$") then
            changed = false
        end
        -- WiFi7 reads WHNAT from init_path at probe and supports a native
        -- runtime setter; unloading the legacy module stack cannot apply it.
        if changed and not (whnat and v == "WHNAT") then
            if utils.exists("/sys/module/mt_wifi/refcnt") == false then
                nixio.syslog("err", "mtwifi-cfg: mtwifi module is build-in, please reboot the device!")
                return false
            end
            reinstall_wifidrv = true
        end
    end

    local module_order
    if reinstall_wifidrv then
        local ok
        ok, module_order = pcall(vendor_module_order)
        if not ok then
            nixio.syslog("err", "mtwifi-cfg: wireless driver has an unrelated consumer")
            return false
        end
    end
    if not stage_profile(changes, profile, dats) or not commit_profiles(changes) then return false end
    local is_dbdc = string.find(profile, "dbdc") ~= nil
    local function recover()
        local _, stopped = mtwifi_down(devname)
        if not restore_profile() then nixio.syslog("err", "mtwifi-cfg: profile recovery failed") end
        if not stopped then nixio.syslog("err", "mtwifi-cfg: wireless cleanup failed") end
        return false
    end

    if reinstall_wifidrv then
        for name in pairs(l1dat.devname_ridx) do
            local _, stopped = mtwifi_down(name)
            if not stopped then
                recover()
                restart_other_radios(devname)
                return false
            end
        end
        if not mtwifi_reinstall(restore_profile, module_order) then
            restart_other_radios(devname)
            return false
        end
        local started = mtwifi_up(devname, cfg, nil, is_dbdc)
        if not started then recover() end
        restart_other_radios(devname)
        if not started then return false end
    elseif is_dbdc and next(cfg_diff) ~= nil then
        local restore_vifs = {}
        local siblings = {}
        for name, radio in pairs(l1dat.devname_ridx) do
            if radio.INDEX == dev.INDEX and radio.mainidx == dev.mainidx then
                siblings[#siblings + 1] = name
            end
        end
        table.sort(siblings)
        local stopped = true
        for _, name in ipairs(siblings) do
            local vifs, ok = mtwifi_down(name, cfg)
            for _, vif in ipairs(vifs) do restore_vifs[#restore_vifs + 1] = vif end
            if not ok then
                stopped = false
                break
            end
        end
        local started = stopped and mtwifi_up(devname, cfg, nil, true)
        if not started then recover() end
        for _, name in ipairs(siblings) do
            if name ~= devname and not mtwifi_up(name, cfg, restore_vifs, true) then
                nixio.syslog("err", "mtwifi-cfg: could not restore " .. name)
            end
        end
        if not started then return false end
    else
        local _, stopped = mtwifi_down(devname)
        if not stopped or not mtwifi_up(devname, cfg, nil, is_dbdc) then return recover() end
    end

    if ownip then
        if not dev.main_ifname:match("^[%w_]+$") or not dev.ext_ifname:match("^[%w_]+$") or
            not command_ok("/usr/bin/8021xd -i " .. dev.main_ifname .. " -p " .. dev.ext_ifname) then
            nixio.syslog("err", "mtwifi-cfg: RADIUS authenticator failed to start")
            return recover()
        end
    end
    mtwifi_cfg_iwpriv_hook(cfg)
    if whnat and not whnat_apply(whnat, whnat_enabled) then
        recover()
        local before = load_profile(whnat.path)
        if before and (before.WHNAT == "0" or before.WHNAT == "1") then whnat_apply(whnat, before.WHNAT) end
        return false
    end
    return true
end

function mtwifi_cfg_down(devname)
    if not l1dat then return false end
    if devname then
        local _, stopped = mtwifi_down(devname)
        return stopped
    end
    local ok = true
    for name in pairs(l1dat.devname_ridx) do
        local _, stopped = mtwifi_down(name)
        if not stopped then ok = false end
    end
    return ok
end

local action = {
    ["whnat"] = function()
        if not mtwifi_cfg_whnat() then os.exit(1) end
    end,
    ["down"] = function(devname)
        if not mtwifi_cfg_down(devname) then os.exit(1) end
    end,

    ["setup"] = function()
        local argv = io.read()
        if not argv or not mtwifi_cfg_setup(argv) then os.exit(1) end
    end
}

if #arg == 1 then
    action[arg[1]]()
elseif #arg == 2 then
    action[arg[1]](arg[2])
end
