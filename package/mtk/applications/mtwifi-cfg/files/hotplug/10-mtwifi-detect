#!/bin/sh

[ "$ACTION" = add ] || return 0
case "$INTERFACE" in
	ra0|rai0|rax0) ;;
	*) return 0 ;;
esac

lock /tmp/mtwifi-detect.lock || return 1
before="$(uci -q show wireless)"
if /sbin/wifi config && [ "$before" != "$(uci -q show wireless)" ]; then
	# If netifd is still starting, it will read the new config itself.
	ubus -t 2 call network reload >/dev/null 2>&1
fi
lock -u /tmp/mtwifi-detect.lock
