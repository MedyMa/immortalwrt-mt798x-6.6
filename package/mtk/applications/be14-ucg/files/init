#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	config_load be14_ucg
	local enabled wired_host network url
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/python3 -B /usr/lib/be14-ucg/agent.py
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool wired_host main wired_host 0
	[ "$wired_host" = 1 ] || return 0
	config_get network main management_network lan
	config_get url main inform_url
	procd_open_instance wired_host
	procd_set_param command /usr/bin/python3 -B /usr/lib/be14-ucg/wired_host.py monitor "$network" "$url"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 16
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger be14_ucg
}
