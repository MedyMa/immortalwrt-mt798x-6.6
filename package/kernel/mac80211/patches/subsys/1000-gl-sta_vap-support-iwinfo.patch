From 073401b771c6231e80139b3ceaeb197430aafd30 Mon Sep 17 00:00:00 2001
From: zengyinbin <yinbin.zeng@gl-inet.com>
Date: Mon, 15 Sep 2025 12:05:04 +0800
Subject: [PATCH] cfg80211: add wdev_sta_chandef() for station channel reporting

---
 include/net/cfg80211.h  |    3 +++
 net/wireless/chan.c     |   23 +++++++++++++++++++++++
 2 files changed, 26 insertions

--- a/include/net/cfg80211.h
+++ b/include/net/cfg80211.h
@@ -6498,6 +6498,9 @@
 struct cfg80211_chan_def *wdev_chandef(struct wireless_dev *wdev,
 				       unsigned int link_id);
 
+bool wdev_sta_chandef(struct wireless_dev *wdev, unsigned int link_id,
+		      struct cfg80211_chan_def *chandef);
+
 static inline void WARN_INVALID_LINK_ID(struct wireless_dev *wdev,
 					unsigned int link_id)
 {
--- a/net/wireless/chan.c
+++ b/net/wireless/chan.c
@@ -1698,3 +1698,26 @@
 	}
 }
 EXPORT_SYMBOL(wdev_chandef);
+
+bool wdev_sta_chandef(struct wireless_dev *wdev, unsigned int link_id,
+		      struct cfg80211_chan_def *chandef)
+{
+	struct cfg80211_internal_bss *bss;
+
+	lockdep_assert_wiphy(wdev->wiphy);
+
+	if (wdev->iftype != NL80211_IFTYPE_STATION &&
+	    wdev->iftype != NL80211_IFTYPE_P2P_CLIENT)
+		return false;
+
+	WARN_ON(wdev->valid_links && !(wdev->valid_links & BIT(link_id)));
+	WARN_ON(!wdev->valid_links && link_id > 0);
+
+	bss = wdev->links[link_id].client.current_bss;
+	if (!bss || !bss->pub.channel)
+		return false;
+
+	cfg80211_chandef_create(chandef, bss->pub.channel, NL80211_CHAN_HT20);
+
+	return true;
+}
-- 
