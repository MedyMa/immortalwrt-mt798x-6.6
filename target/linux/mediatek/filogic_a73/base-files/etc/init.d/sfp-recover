#!/bin/sh /etc/rc.common
# Standard BPI-R4 SFP boot recovery, once per boot.
#
# No carrier alone is normal with no light, no cable or a powered-off peer.
# Only a stable, explicit failure reported by the existing kernel SFP state
# machine permits automatic recovery. Unknown/missing state is left alone.
# This existing debugfs file copies cached software state; do not mount
# debugfs, read EEPROM or infer effective LOS from the raw GPIO bit.
#
# Preserve bounded retraining and one re-probe for confirmed failures.
# Do not cycle netdev admin state: a later forced UP could override a user
# shutting down the port. Rebinding SFP does not force the netdev admin-UP.
# State checks are not atomic with kernel/hotplug changes, so recheck before
# every recovery action and stop when the failure evidence changes.
#
# Manual re-run: rm -f /var/run/sfp_recover_done; /etc/init.d/sfp-recover start

START=98

# Standard R4: gmac1/eth1 -> sfp2; gmac2/eth2 -> sfp1.
: "${SFP_CAGES:=eth1:sfp2 eth2:sfp1}"
: "${SFP_IFACE_WAIT:=60}"
: "${SFP_RETRIES:=5}"
: "${SFP_RETRY_DELAY:=3}"
: "${SFP_NET_SYSFS:=/sys/class/net}"
: "${SFP_DRV_DIR:=/sys/bus/platform/drivers/sfp}"
: "${SFP_DEBUGFS_ROOT:=/sys/kernel/debug}"
: "${SFP_STAMP_DIR:=/var/run}"

sfp_log() {
	logger -t sfp-recover "$*"
}

sfp_iface_exists() {
	[ -e "$SFP_NET_SYSFS/$1" ]
}

sfp_have_carrier() {
	local carrier
	read -r carrier < "$SFP_NET_SYSFS/$1/carrier" 2>/dev/null &&
		[ "$carrier" = 1 ]
}

# Set SFP_FAILURE only for the two terminal failures defined in sfp.c.
# The state file is a short seq_file of cached fields, not an I2C operation.
sfp_failure_evidence() { # $1 = iface, $2 = SFP platform device
	local flags digits carrier snapshot parsed module device main present
	SFP_FAILURE=
	SFP_SKIP_REASON="state unavailable"

	case "$1:$2" in
		*[!a-zA-Z0-9_.:-]*) SFP_SKIP_REASON="invalid cage name"; return 1 ;;
	esac
	read -r flags < "$SFP_NET_SYSFS/$1/flags" 2>/dev/null || return 1
	case "$flags" in
		0) SFP_SKIP_REASON="administratively down"; return 1 ;;
		0x*) digits="${flags#0x}" ;;
		*) return 1 ;;
	esac
	case "$digits" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
	[ "${#digits}" -le 8 ] || return 1
	[ "$((flags & 1))" -eq 1 ] || {
		SFP_SKIP_REASON="administratively down"
		return 1
	}
	read -r carrier < "$SFP_NET_SYSFS/$1/carrier" 2>/dev/null || return 1
	case "$carrier" in
		1) SFP_SKIP_REASON="carrier present"; return 1 ;;
		0) ;;
		*) return 1 ;;
	esac
	[ -e "$SFP_DRV_DIR/$2" ] || return 1

	# sfp_debug_state_show() currently emits 14 lines. Bound the snapshot,
	# reject duplicate/missing fields, and accept only known state tuples.
	snapshot="$(head -n 20 "$SFP_DEBUGFS_ROOT/$2/state" 2>/dev/null)" || return 1
	parsed="$(printf '%s\n' "$snapshot" | awk -F ': ' '
		$1 == "Module state" || $1 == "Device state" ||
		$1 == "Main state" || $1 == "moddef0" { if (NF != 2) bad = 1 }
		$1 == "Module state" { m = $2; mc++ }
		$1 == "Device state" { d = $2; dc++ }
		$1 == "Main state" { s = $2; sc++ }
		$1 == "moddef0" { p = $2; pc++ }
		END {
			if (bad || mc != 1 || dc != 1 || sc != 1 || pc != 1) exit 1
			printf "%s|%s|%s|%s\n", m, d, s, p
		}')" || return 1
	IFS='|' read -r module device main present <<EOF
$parsed
EOF
	[ "$present" = 1 ] || {
		SFP_SKIP_REASON="module absent or presence unknown"
		return 1
	}
	[ "$device" = up ] || {
		SFP_SKIP_REASON="SFP device not up"
		return 1
	}
	case "$module:$main" in
		error:down) SFP_FAILURE="module-error" ;;
		present:fail) SFP_FAILURE="module-fail" ;;
		*)
			SFP_SKIP_REASON="no terminal SFP failure ($module/$main)"
			return 1
			;;
	esac
	return 0
}

sfp_same_failure() { # $1 = iface, $2 = device, $3 = expected failure
	sfp_failure_evidence "$1" "$2" && [ "$SFP_FAILURE" = "$3" ]
}

sfp_reprobe() ( # $1 = iface, $2 = device, $3 = expected failure
	local iface="$1" dev="$2" pending=0
	sfp_same_failure "$iface" "$dev" "$3" || exit 1
	# Scope the cleanup traps to this child shell, preserving rc.common's
	# caller traps. A caught signal must not leave the driver detached.
	restore_sfp_binding() {
		[ "$pending" = 1 ] && [ ! -e "$SFP_DRV_DIR/$dev" ] || return 0
		printf '%s\n' "$dev" > "$SFP_DRV_DIR/bind" 2>/dev/null ||
			sfp_log "$iface: failed to restore SFP binding for $dev"
	}
	trap 'restore_sfp_binding' EXIT
	trap 'exit 1' HUP INT TERM
	sfp_log "$iface: re-probing $dev after stable $3"
	pending=1
	printf '%s\n' "$dev" > "$SFP_DRV_DIR/unbind" 2>/dev/null || {
		pending=0
		exit 1
	}
	sleep 1
	# Restore binding even if an administrator took the netdev down in the
	# meantime. Binding alone must not force the netdev admin-UP.
	printf '%s\n' "$dev" > "$SFP_DRV_DIR/bind" 2>/dev/null || {
		sfp_log "$iface: failed to restore SFP binding for $dev"
		exit 1
	}
	pending=0
	exit 0
)

sfp_wait_iface() { # $1 = iface, $2 = seconds
	local i=0
	while [ "$i" -lt "$2" ]; do
		sfp_iface_exists "$1" && return 0
		i=$((i + 1))
		sleep 1
	done
	sfp_iface_exists "$1"
}

sfp_recover_cage() { # $1 = iface, $2 = platform device
	local iface="$1" dev="$2" i failure

	if ! sfp_iface_exists "$iface"; then
		sfp_log "$iface: waiting up to ${SFP_IFACE_WAIT}s for the netdev"
		sfp_wait_iface "$iface" "$SFP_IFACE_WAIT" || {
			sfp_log "$iface: netdev missing; no admin/module evidence, skipping"
			return 0
		}
	fi

	if ! sfp_failure_evidence "$iface" "$dev"; then
		sfp_log "$iface: skipping recovery: $SFP_SKIP_REASON"
		return 0
	fi
	failure="$SFP_FAILURE"
	# A second observation avoids acting on a single transitional snapshot.
	sleep "$SFP_RETRY_DELAY"
	if ! sfp_same_failure "$iface" "$dev" "$failure"; then
		sfp_log "$iface: failure evidence changed; leaving normal state machine"
		return 0
	fi

	# EEPROM/module errors need a new probe, not link autonegotiation.
	if [ "$failure" = module-fail ]; then
		i=0
		while [ "$i" -lt "$SFP_RETRIES" ]; do
			sfp_same_failure "$iface" "$dev" "$failure" || return 0
			i=$((i + 1))
			ethtool -r "$iface" >/dev/null 2>&1
			sleep "$SFP_RETRY_DELAY"
			if sfp_have_carrier "$iface"; then
				sfp_log "$iface: carrier up after retrain ${i}"
				return 0
			fi
		done
	fi

	if ! sfp_reprobe "$iface" "$dev" "$failure"; then
		sfp_log "$iface: re-probe skipped or failed; no forced link cycling"
		return 1
	fi
	sleep "$SFP_RETRY_DELAY"
	if sfp_have_carrier "$iface"; then
		sfp_log "$iface: carrier up after re-probing $dev"
		return 0
	fi
	sfp_log "$iface: re-probed $dev; no carrier does not establish module failure"
	return 0
}

sfp_recover_all() {
	local pair
	for pair in $SFP_CAGES; do
		sfp_recover_cage "${pair%%:*}" "${pair##*:}"
	done
	sfp_log "recovery pass finished"
}

start() {
	[ -e "$SFP_STAMP_DIR/sfp_recover_done" ] && return 0
	: > "$SFP_STAMP_DIR/sfp_recover_done"
	( sfp_recover_all ) &
}

boot() {
	start
}

stop() {
	:
}
