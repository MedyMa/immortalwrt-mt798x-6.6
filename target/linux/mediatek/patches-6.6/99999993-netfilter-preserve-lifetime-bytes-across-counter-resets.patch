+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+/* Keep lifetime metadata outside the u8-sized conntrack extension area. */
+struct nf_ct_acct_totals {
+	seqlock_t lock;
+	u64 reset_bytes[IP_CT_DIR_MAX];
+	u64 reset_packets[IP_CT_DIR_MAX];
+	u64 id;
+};
+#endif
+
 struct nf_conn_acct {
 	struct nf_conn_counter counter[IP_CT_DIR_MAX];
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	struct nf_ct_acct_totals *total;
+#endif
 };
 
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+void nf_ct_acct_init_totals(struct nf_conn_acct *acct, gfp_t gfp);
+void nf_ct_acct_free_totals(struct nf_conn *ct);
