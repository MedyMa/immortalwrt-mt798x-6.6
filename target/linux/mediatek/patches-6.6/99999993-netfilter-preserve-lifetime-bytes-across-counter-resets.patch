+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+static void seq_print_acct_totals(struct seq_file *s, const struct nf_conn *ct)
+{
+	const struct nf_conn_acct *acct = nf_conn_acct_find(ct);
+	u64 packets[IP_CT_DIR_MAX], bytes[IP_CT_DIR_MAX];
+	unsigned int dir;
+
+	if (!acct || !acct->total)
+		return;
+	for (dir = 0; dir < IP_CT_DIR_MAX; dir++)
+		nf_ct_acct_read_totals(acct, dir, &packets[dir], &bytes[dir]);
+	seq_printf(s, "traffic_id=%llu packets_total=%llu bytes_total=%llu "
+		   "packets_total=%llu bytes_total=%llu ",
+		   acct->total->id, packets[0], bytes[0], packets[1], bytes[1]);
+}
+#endif
