 struct nf_conn_acct {
 	struct nf_conn_counter counter[IP_CT_DIR_MAX];
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	/* GET_CTRZERO remains resettable for nlbwmon. Read-only proc clients
+	 * also need the bytes consumed by every earlier reset of this CT.
+	 * No extra work is added to software or hardware packet accounting.
+	 */
+	seqlock_t total_lock;
+	u64 reset_bytes[IP_CT_DIR_MAX];
+#endif
 };
+
+static inline void nf_ct_acct_read_reset(struct nf_conn_acct *acct, u32 dir,
+					u64 *packets, u64 *bytes)
+{
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	write_seqlock_bh(&acct->total_lock);
+#endif
+	*packets = atomic64_xchg(&acct->counter[dir].packets, 0);
+	*bytes = atomic64_xchg(&acct->counter[dir].bytes, 0);
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	acct->reset_bytes[dir] += *bytes;
+	write_sequnlock_bh(&acct->total_lock);
+#endif
+}
+
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+static inline u64 nf_ct_acct_total_bytes(struct nf_conn_acct *acct, u32 dir)
+{
+	unsigned int seq;
+	u64 bytes;
+
+	/* Readers must not observe the gap between xchg and carry. Writers
+	 * serialize concurrent netlink dumps and disable BH while seq is odd.
+	 */
+	do {
+		seq = read_seqbegin(&acct->total_lock);
+		bytes = acct->reset_bytes[dir] +
+			atomic64_read(&acct->counter[dir].bytes);
+	} while (read_seqretry(&acct->total_lock, seq));
+
+	return bytes;
+}
+#endif
 
