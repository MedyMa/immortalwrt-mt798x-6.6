+
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+static atomic64_t nf_ct_acct_sequence = ATOMIC64_INIT(0);
+
+void nf_ct_acct_init_totals(struct nf_conn_acct *acct, gfp_t gfp)
+{
+	struct nf_ct_acct_totals *total;
+
+	total = kzalloc(sizeof(*total), gfp);
+	if (!total)
+		return; /* Ordinary/resettable accounting remains usable. */
+	seqlock_init(&total->lock);
+	total->id = atomic64_inc_return(&nf_ct_acct_sequence);
+	acct->total = total;
+}
+EXPORT_SYMBOL_GPL(nf_ct_acct_init_totals);
+
+void nf_ct_acct_free_totals(struct nf_conn *ct)
+{
+	struct nf_conn_acct *acct = nf_conn_acct_find(ct);
+
+	if (acct)
+		kfree(acct->total);
+}
+#endif
