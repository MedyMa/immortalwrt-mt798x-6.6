+#endif
+#if defined(CONFIG_NF_HNAT_PACKET_ACCOUNTING) && defined(CONFIG_NF_CONNTRACK_PROCFS)
+void nf_ct_acct_record_destroy(const struct nf_conn *ct);
+void nf_ct_acct_closed_init(struct net *net);
+void nf_ct_acct_closed_fini(struct net *net);
+#else
+static inline void nf_ct_acct_record_destroy(const struct nf_conn *ct) { }
+static inline void nf_ct_acct_closed_init(struct net *net) { }
+static inline void nf_ct_acct_closed_fini(struct net *net) { }
+#endif
+
+static inline void nf_ct_acct_read_reset(struct nf_conn_acct *acct, u32 dir,
+					u64 *packets, u64 *bytes)
+{
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	struct nf_ct_acct_totals *total = acct->total;
+
+	if (total)
+		write_seqlock_bh(&total->lock);
+#endif
+	*packets = atomic64_xchg(&acct->counter[dir].packets, 0);
+	*bytes = atomic64_xchg(&acct->counter[dir].bytes, 0);
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	if (total) {
+		total->reset_bytes[dir] += *bytes;
+		total->reset_packets[dir] += *packets;
+		write_sequnlock_bh(&total->lock);
+	}
+#endif
+}
+
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+static inline bool nf_ct_acct_read_totals(const struct nf_conn_acct *acct, u32 dir,
+					 u64 *packets, u64 *bytes)
+{
+	struct nf_ct_acct_totals *total = acct->total;
+	unsigned int seq;
+
+	if (!total)
+		return false;
+	/* No reader observes the gap between GET_CTRZERO and the carry. */
+	do {
+		seq = read_seqbegin(&total->lock);
+		*bytes = total->reset_bytes[dir] +
+			 atomic64_read(&acct->counter[dir].bytes);
+		*packets = total->reset_packets[dir] +
+			   atomic64_read(&acct->counter[dir].packets);
+	} while (read_seqretry(&total->lock, seq));
+	return true;
+}
+#endif
