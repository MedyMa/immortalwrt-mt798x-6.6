+static void mtk_unregister_mac_notifier(struct mtk_mac *mac)
+{
+	if (!mac->notifier_registered)
+		return;
+
+	unregister_netdevice_notifier(&mac->device_notifier);
+	mac->notifier_registered = false;
+}
+
+static void mtk_free_mac(struct mtk_eth *eth, int id)
+{
+	struct net_device *dev = eth->netdev[id];
+	struct mtk_mac *mac;
+
+	if (!dev)
+		return;
+
+	mac = netdev_priv(dev);
+	mtk_unregister_mac_notifier(mac);
+	if (mac->phylink_default)
+		phylink_destroy(mac->phylink_default);
+	if (!IS_ERR_OR_NULL(mac->sgmii_pcs))
+		mtk_pcs_lynxi_put(mac->sgmii_pcs);
+	if (!IS_ERR_OR_NULL(mac->usxgmii_pcs))
+		mtk_usxgmii_pcs_put(mac->usxgmii_pcs);
+
+	eth->netdev[id] = NULL;
+	eth->mac[id] = NULL;
+	free_netdev(dev);
+}
