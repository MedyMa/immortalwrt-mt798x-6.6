 	ext->chunks = newlen;
@@ -6800,6 +6807,10 @@
 	struct skb_ext *ext = skb->extensions;
 
 	skb->active_extensions &= ~(1 << id);
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	if (id == SKB_EXT_HNAT_ACCOUNTING)
+		skb_hnat_accounting_revoke(skb);
+#endif
 	if (skb->active_extensions == 0) {
 		skb->extensions = NULL;
 		__skb_ext_put(ext);
