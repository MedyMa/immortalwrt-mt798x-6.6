From: Local experimental HNAT accounting
Subject: [PATCH] netfilter: keep HNAT rule deltas on synthetic skb

Default n; requires matching early-mark/late-publish HNAT producer.

--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -921,6 +921,11 @@
 	__u8			active_extensions;
 #endif
 
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	/* Ordinary=0, pending=1, published=2, terminal synthetic zero=3. */
+	__u8 hnat_accounting_state;
+#endif
+
 	/* Fields enclosed in headers group are copied
 	 * using a single memcpy() in __copy_skb_header()
 	 */
@@ -4658,9 +4663,22 @@
 #endif
 }
 
+/* Revoke before releasing/replacing the skb's CT reference. No CT cookie
+ * is required: a published snapshot cannot survive reference replacement.
+ */
+static inline void skb_hnat_accounting_revoke(struct sk_buff *skb)
+{
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	if (skb->hnat_accounting_state == 2)
+		skb->hnat_accounting_state = 3;
+#endif
+}
+
 static inline void skb_set_nfct(struct sk_buff *skb, unsigned long nfct)
 {
 #if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	if (skb->_nfct != nfct)
+		skb_hnat_accounting_revoke(skb);
 	skb->slow_gro |= !!nfct;
 	skb->_nfct = nfct;
 #endif
@@ -4682,6 +4700,9 @@
 #endif
 #if IS_ENABLED(CONFIG_MCTP_FLOWS)
 	SKB_EXT_MCTP,
+#endif
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	SKB_EXT_HNAT_ACCOUNTING,
 #endif
 	SKB_EXT_NUM, /* must be last */
 };
@@ -4720,6 +4741,9 @@
 				  const struct sk_buff *src)
 {
 	dst->active_extensions = src->active_extensions;
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+	dst->hnat_accounting_state = src->hnat_accounting_state ? 3 : 0;
+#endif
 
 	if (src->active_extensions) {
 		struct skb_ext *ext = src->extensions;
@@ -4764,6 +4788,7 @@
 
 static inline void skb_ext_reset(struct sk_buff *skb)
 {
+	skb_hnat_accounting_revoke(skb);
 	if (unlikely(skb->active_extensions)) {
 		__skb_ext_put(skb->extensions);
 		skb->active_extensions = 0;
@@ -4786,6 +4811,7 @@
 static inline void nf_reset_ct(struct sk_buff *skb)
 {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
+	skb_hnat_accounting_revoke(skb);
 	nf_conntrack_put(skb_nfct(skb));
 	skb->_nfct = 0;
 #endif
@@ -4810,6 +4836,7 @@
 			     bool copy)
 {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
+	skb_hnat_accounting_revoke(dst);
 	dst->_nfct = src->_nfct;
 	nf_conntrack_get(skb_nfct(src));
 #endif
@@ -4822,6 +4849,7 @@
 static inline void nf_copy(struct sk_buff *dst, const struct sk_buff *src)
 {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
+	skb_hnat_accounting_revoke(dst);
 	nf_conntrack_put(skb_nfct(dst));
 #endif
 	dst->slow_gro = src->slow_gro;
