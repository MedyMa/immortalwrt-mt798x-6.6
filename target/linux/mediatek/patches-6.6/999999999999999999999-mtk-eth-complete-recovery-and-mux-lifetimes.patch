+/* Serialize the final queue operation with teardown, including atomic TX
+ * timeout producers that cannot be drained through the notifier chain.
+ */
+void mtk_eth_queue_reset(struct mtk_eth *eth)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->reset.lock, flags);
+	if (!test_bit(MTK_STOPPING, &eth->state) &&
+	    !test_bit(MTK_RESETTING, &eth->state))
+		schedule_work(&eth->pending_work);
+	spin_unlock_irqrestore(&eth->reset.lock, flags);
+}
+
+bool mtk_eth_reset_stop(struct mtk_eth *eth)
+{
+	unsigned long flags;
+	bool stopping;
+
+	spin_lock_irqsave(&eth->reset.lock, flags);
+	stopping = test_and_set_bit(MTK_STOPPING, &eth->state);
+	spin_unlock_irqrestore(&eth->reset.lock, flags);
+	return stopping;
+}
+
+/* The notifier and its callers serialize reset phase changes with RTNL. */
+void mtk_eth_reset_prepare(struct mtk_eth *eth, u8 phase)
+{
+	ASSERT_RTNL();
+	eth->reset.wait_phase = phase;
+	mtk_rest_cnt = mtk_wifi_num;
+	if (phase == MTK_WIFI_WAIT_FINISH)
+		reinit_completion(&wait_ack_done);
+	else {
+		reinit_completion(&wait_ser_done);
+		mtk_stop_fail = false;
+	}
+}
