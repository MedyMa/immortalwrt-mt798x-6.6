+/* Never free DMA after a missing WiFi stop ACK. Teardown can cancel a wait
+ * promptly; a live timeout leaves RESETTING set and requires explicit recovery.
+ */
+static bool mtk_wait_for_reset_ack(struct mtk_eth *eth, struct completion *done,
+			      const char *phase)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(30000);
+
+	while (!test_bit(MTK_STOPPING, &eth->state)) {
+		if (done == &wait_tops_done &&
+		    (!READ_ONCE(eth->reset.npu_present) || READ_ONCE(eth->reset.npu_failed)))
+			return false;
+		if (wait_for_completion_timeout(done, msecs_to_jiffies(100)))
+			return !test_bit(MTK_STOPPING, &eth->state);
+		if (time_after_eq(jiffies, deadline)) {
+			dev_err(eth->dev, "FE reset timed out waiting for %s; keeping reset blocked\n",
+				phase);
+			break;
+		}
+	}
+	return false;
+}
