+static int pptp_get_tunnel_info(struct ppp_channel *chan,
+				struct ppp_tunnel_info *info)
+{
+	struct sock *sk = chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+	struct pptp_opt *opt = &po->proto.pptp;
+	unsigned long flags;
+
+	if (!(sk->sk_state & PPPOX_CONNECTED))
+		return -ENOTCONN;
+	if (READ_ONCE(opt->ppp_flags) & (SC_COMP_AC | SC_COMP_PROT))
+		return -EOPNOTSUPP;
+	spin_lock_irqsave(&opt->offload_lock, flags);
+	info->kind = PPP_TUNNEL_PPTP;
+	info->version = 1;
+	info->tunnel_id = opt->src_addr.call_id;
+	info->peer_tunnel_id = opt->dst_addr.call_id;
+	info->cookie = opt->offload_cookie;
+	info->local_addr = opt->src_addr.sin_addr.s_addr;
+	info->peer_addr = opt->dst_addr.sin_addr.s_addr;
+	info->sequence = opt->seq_sent;
+	info->ppp_flags = opt->ppp_flags;
+	spin_unlock_irqrestore(&opt->offload_lock, flags);
+	return 0;
+}
+#else
+static int pptp_next_seq(struct pppox_sock *po, u32 *seq)
+{
+	*seq = ++po->proto.pptp.seq_sent;
+	return 0;
+}
