+int pptp_offload_ops_register(const struct pptp_offload_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->next || !ops->snapshot || !ops->close)
+		return -EINVAL;
+	mutex_lock(&pptp_offload_admin);
+	if (rcu_access_pointer(pptp_offload_ops))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(pptp_offload_ops, ops);
+	mutex_unlock(&pptp_offload_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_ops_register);
