+int ppp_channel_tunnel_quiesce(struct ppp_channel *chan)
+{
+	struct channel *pch = chan ? chan->ppp : NULL;
+	struct net_device *dev = NULL;
+	int ret = 0;
+
+	if (!pch)
+		return 0;
+	read_lock_bh(&pch->upl);
+	if (pch->ppp) {
+		dev = pch->ppp->dev;
+		dev_hold(dev);
+	}
+	read_unlock_bh(&pch->upl);
+	if (dev) {
+		ret = ppp_tunnel_quiesce(netdev_priv(dev));
+		dev_put(dev);
+	}
+	return ret;
+}
