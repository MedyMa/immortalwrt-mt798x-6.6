+bool pptp_offload_session_live(const struct pptp_offload_key *key)
+{
+	struct pppox_sock *po;
+	struct pptp_opt *opt;
+	unsigned long flags;
+	bool live = false;
+
+	if (!key || !key->cookie)
+		return false;
+	spin_lock_irqsave(&chan_lock, flags);
+	po = rcu_access_pointer(callid_sock[key->local_id]);
+	if (po) {
+		opt = &po->proto.pptp;
+		live = (READ_ONCE(sk_pppox(po)->sk_state) & PPPOX_CONNECTED) &&
+		       opt->offload_cookie == key->cookie &&
+		       sock_net(sk_pppox(po))->ns.inum == key->netns &&
+		       opt->src_addr.sin_addr.s_addr == key->local_addr &&
+		       opt->dst_addr.sin_addr.s_addr == key->peer_addr &&
+		       opt->src_addr.call_id == key->local_id &&
+		       opt->dst_addr.call_id == key->peer_id;
+	}
+	spin_unlock_irqrestore(&chan_lock, flags);
+	return live;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_session_live);
