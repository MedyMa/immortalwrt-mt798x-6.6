+{
+	struct sock *sk = chan->private;
+	struct pptp_opt *opt = &pppox_sk(sk)->proto.pptp;
+
+	if (path->flags & BIT(DEV_PATH_TNL))
+		return -EEXIST;
+	if (!(sk->sk_state & PPPOX_CONNECTED))
+		return -ENOTCONN;
+	/* Firmware consumes the full address/control and protocol fields. */
+	if (opt->ppp_flags & (SC_COMP_AC | SC_COMP_PROT))
+		return -EOPNOTSUPP;
+	path->flags |= BIT(DEV_PATH_TNL);
+	path->tnl_type = FLOW_OFFLOAD_TNL_PPTP;
+	return 0;
+}
+#endif
