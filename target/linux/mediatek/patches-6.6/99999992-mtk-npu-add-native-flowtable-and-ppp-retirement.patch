+#if IS_ENABLED(CONFIG_NET_MEDIATEK_NPU_FLOW)
+static int pptp_fill_forward_path(struct net_device_path_ctx *ctx,
+				  struct net_device_path *path,
+				  const struct ppp_channel *chan)
+{
+	struct sock *sk = chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+	struct ppp_tunnel_info info;
+	struct flowi4 fl4;
+	struct rtable *rt;
+	int ret;
+
+	if (!mtk_npu_flow_supported(DEV_PATH_PPTP))
+		return -EOPNOTSUPP;
+	ret = pptp_get_tunnel_info((struct ppp_channel *)chan, &info);
+	if (ret)
+		return ret;
+	rt = pptp_route_output(po, &fl4);
+	if (IS_ERR(rt))
+		return PTR_ERR(rt);
+	ret = mtk_npu_flow_neigh(&rt->dst, info.peer_addr, path);
+	if (!ret) {
+		path->type = DEV_PATH_PPTP;
+		path->dev = ctx->dev;
+		path->tunnel.sip.ip = info.local_addr;
+		path->tunnel.dip.ip = info.peer_addr;
+		path->tunnel.ttl = ip4_dst_hoplimit(&rt->dst);
+		path->tunnel.tos = 0;
+		path->tunnel.pptp.call_id = info.tunnel_id;
+		path->tunnel.pptp.peer_call_id = info.peer_tunnel_id;
+		path->tunnel.pptp.seq_sent = info.sequence;
+		path->tunnel.pptp.cookie = info.cookie;
+		ctx->dev = rt->dst.dev;
+	}
+	ip_rt_put(rt);
+	return ret;
+}
+#endif
