+void ppp_channel_tunnel_invalidate(struct ppp_channel *chan)
+{
+	struct channel *pch = chan ? chan->ppp : NULL;
+	const struct ppp_tunnel_offload_ops *ops;
+	struct net_device *dev = NULL;
+	int idx;
+
+	if (!pch)
+		return;
+	read_lock_bh(&pch->upl);
+	if (pch->ppp) {
+		WRITE_ONCE(pch->ppp->tunnel_offload_blocked, true);
+		dev = pch->ppp->dev;
+		dev_hold(dev);
+	}
+	read_unlock_bh(&pch->upl);
+	if (!dev)
+		return;
+	idx = srcu_read_lock(&ppp_tunnel_srcu);
+	ops = srcu_dereference(ppp_tunnel_ops, &ppp_tunnel_srcu);
+	if (ops)
+		ops->invalidate(dev);
+	srcu_read_unlock(&ppp_tunnel_srcu, idx);
+	dev_put(dev);
+}
+EXPORT_SYMBOL_GPL(ppp_channel_tunnel_invalidate);
