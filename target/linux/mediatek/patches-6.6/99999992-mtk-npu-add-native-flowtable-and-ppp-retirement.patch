+static const struct mtk_npu_flow_ops __rcu *mtk_npu_flow_ops;
+static u64 mtk_npu_flow_generation;
+
+int mtk_npu_flow_register(const struct mtk_npu_flow_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->supported || !ops->prepare || !ops->bind || !ops->unbind)
+		return -EINVAL;
+	mutex_lock(&mtk_npu_flow_admin);
+	if (rcu_access_pointer(mtk_npu_flow_ops)) {
+		ret = -EBUSY;
+	} else {
+		if (!++mtk_npu_flow_generation)
+			mtk_npu_flow_generation++;
+		rcu_assign_pointer(mtk_npu_flow_ops, ops);
+	}
+	mutex_unlock(&mtk_npu_flow_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_register);
+
+int mtk_npu_flow_unregister(const struct mtk_npu_flow_ops *ops)
+{
+	int ret = 0;
+
+	mutex_lock(&mtk_npu_flow_admin);
+	if (!ops || rcu_access_pointer(mtk_npu_flow_ops) != ops) {
+		ret = -ENOENT;
+	} else {
+		RCU_INIT_POINTER(mtk_npu_flow_ops, NULL);
+		synchronize_net();
+	}
+	mutex_unlock(&mtk_npu_flow_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_unregister);
+
+bool mtk_npu_flow_supported(enum net_device_path_type type)
+{
+	const struct mtk_npu_flow_ops *ops;
+	bool ret = false;
+
+	rcu_read_lock_bh();
+	ops = rcu_dereference_bh(mtk_npu_flow_ops);
+	if (ops)
+		ret = ops->supported(type);
+	rcu_read_unlock_bh();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_supported);
+
+int mtk_npu_flow_prepare(const struct net_device_path *path,
+			 struct mtk_npu_flow_token *token)
+{
+	const struct mtk_npu_flow_ops *ops;
+	struct mtk_npu_flow_token result = {};
+	int ret = -EOPNOTSUPP;
+
+	if (!path || !token)
+		return -EINVAL;
+	memset(token, 0, sizeof(*token));
+	rcu_read_lock_bh();
+	ops = rcu_dereference_bh(mtk_npu_flow_ops);
+	if (ops && ops->supported(path->type)) {
+		ret = ops->prepare(path, &result);
+		if (!ret) {
+			if (result.entry < MTK_NPU_FLOW_FIRST ||
+			    result.entry > MTK_NPU_FLOW_LAST || !result.generation ||
+			    !result.allocation || !result.tunnel_ifindex || !result.egress_ifindex) {
+				ret = -ERANGE;
+			} else {
+				result.provider = READ_ONCE(mtk_npu_flow_generation);
+				result.flags = MTK_NPU_FLOW_F_ENCAP;
+				*token = result;
+			}
+		}
+	}
+	rcu_read_unlock_bh();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_prepare);
+
+bool mtk_npu_flow_lock(const struct mtk_npu_flow_token *token,
+		       struct mtk_npu_flow_guard *guard)
+{
+	const struct mtk_npu_flow_ops *ops;
+
+	if (!token || !guard || token->entry < MTK_NPU_FLOW_FIRST ||
+	    token->entry > MTK_NPU_FLOW_LAST || !token->generation ||
+	    !token->allocation || !token->tunnel_ifindex || !token->egress_ifindex ||
+	    (token->flags & ~MTK_NPU_FLOW_F_ENCAP))
+		return false;
+	guard->ops = NULL;
+	guard->owner = NULL;
+	rcu_read_lock_bh();
+	ops = rcu_dereference_bh(mtk_npu_flow_ops);
+	if (ops && token->provider == READ_ONCE(mtk_npu_flow_generation) &&
+	    ops->bind(token, &guard->owner)) {
+		guard->ops = ops;
+		return true;
+	}
+	rcu_read_unlock_bh();
+	return false;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_lock);
+
+void mtk_npu_flow_unlock(struct mtk_npu_flow_guard *guard)
+{
+	if (WARN_ON_ONCE(!guard || !guard->ops))
+		return;
+	guard->ops->unbind(guard->owner);
+	guard->ops = NULL;
+	guard->owner = NULL;
+	rcu_read_unlock_bh();
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_unlock);
+
+int mtk_npu_flow_neigh(struct dst_entry *dst, __be32 peer,
+                       struct net_device_path *path)
+{
+	struct neighbour *neigh;
+
+	/* The native backend initially accepts a plain Ethernet underlay. The
+	 * HNAT backend owns the separate VLAN/PPPoE/bridge adaptation path.
+	 */
+	if (!dst || !path || !dst_check(dst, 0) || dst_xfrm(dst) ||
+	    dst->dev->type != ARPHRD_ETHER || !netif_running(dst->dev) ||
+	    is_vlan_dev(dst->dev) || netif_is_bridge_master(dst->dev) ||
+	    netdev_uses_dsa(dst->dev))
+		return -EOPNOTSUPP;
+	neigh = dst_neigh_lookup(dst, &peer);
+	if (!neigh)
+		return -EHOSTUNREACH;
+	if (!(READ_ONCE(neigh->nud_state) & NUD_VALID)) {
+		neigh_release(neigh);
+		return -EHOSTUNREACH;
+	}
+	neigh_ha_snapshot(path->tunnel.h_dest, neigh, dst->dev);
+	ether_addr_copy(path->tunnel.h_source, dst->dev->dev_addr);
+	path->tunnel.underlay_ifindex = dst->dev->ifindex;
+	neigh_release(neigh);
+	return is_valid_ether_addr(path->tunnel.h_dest) &&
+	       is_valid_ether_addr(path->tunnel.h_source) ? 0 : -EHOSTUNREACH;
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_neigh);
