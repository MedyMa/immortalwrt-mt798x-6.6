+static DEFINE_MUTEX(mtk_crypto_net_lock);
+DEFINE_STATIC_SRCU(mtk_crypto_srcu);
+static const struct mtk_crypto_net_ops __rcu *mtk_crypto_net_ops;
+
+int mtk_crypto_net_register(const struct mtk_crypto_net_ops *ops)
+{
+        int ret = 0;
+
+        if (!ops || !ops->rx || !ops->tx || !ops->owner || !ops->xfrm)
+                return -EINVAL;
+        mutex_lock(&mtk_crypto_net_lock);
+        if (rcu_access_pointer(mtk_crypto_net_ops))
+                ret = -EBUSY;
+        else
+                rcu_assign_pointer(mtk_crypto_net_ops, ops);
+        mutex_unlock(&mtk_crypto_net_lock);
+        return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_crypto_net_register);
+
+void mtk_crypto_net_unregister(const struct mtk_crypto_net_ops *ops)
+{
+        mutex_lock(&mtk_crypto_net_lock);
+        if (rcu_access_pointer(mtk_crypto_net_ops) == ops) {
+                RCU_INIT_POINTER(mtk_crypto_net_ops, NULL);
+                synchronize_net();
+                synchronize_srcu(&mtk_crypto_srcu);
+        }
+        mutex_unlock(&mtk_crypto_net_lock);
+}
+EXPORT_SYMBOL_GPL(mtk_crypto_net_unregister);
+
+#if IS_ENABLED(CONFIG_XFRM_OFFLOAD)
+/* A permanent MAC-side dispatch table keeps XFRM from retaining pointers to
+ * removable EIP module text. SRCU covers sleeping add/free callbacks; module
+ * references are returned here, after the provider callback has returned.
+ */
+static int mtk_crypto_state_add(struct xfrm_state *xs, struct netlink_ext_ack *extack)
+{
+        const struct mtk_crypto_net_ops *ops;
+        int idx, ret = -ENODEV;
+
+        idx = srcu_read_lock(&mtk_crypto_srcu);
+        ops = srcu_dereference(mtk_crypto_net_ops, &mtk_crypto_srcu);
+        if (ops && try_module_get(ops->owner)) {
+                ret = ops->xfrm->xdo_dev_state_add(xs, extack);
+                if (ret)
+                        module_put(ops->owner);
+        }
+        srcu_read_unlock(&mtk_crypto_srcu, idx);
+        return ret;
+}
+
+static int mtk_crypto_policy_add(struct xfrm_policy *xp, struct netlink_ext_ack *extack)
+{
+        const struct mtk_crypto_net_ops *ops;
+        int idx, ret = -ENODEV;
+
+        idx = srcu_read_lock(&mtk_crypto_srcu);
+        ops = srcu_dereference(mtk_crypto_net_ops, &mtk_crypto_srcu);
+        if (ops && try_module_get(ops->owner)) {
+                ret = ops->xfrm->xdo_dev_policy_add(xp, extack);
+                if (ret)
+                        module_put(ops->owner);
+        }
+        srcu_read_unlock(&mtk_crypto_srcu, idx);
+        return ret;
+}
