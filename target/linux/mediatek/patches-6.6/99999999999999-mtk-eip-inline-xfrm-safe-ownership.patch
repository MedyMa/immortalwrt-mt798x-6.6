+static bool mtk_crypto_tx_skb(struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_XFRM_OFFLOAD)
+        struct sec_path *sp = skb_sec_path(skb);
+        struct xfrm_offload *xo;
+        struct xfrm_state *xs;
+
+        if (!sp || !sp->len || sp->len > XFRM_MAX_DEPTH)
+                return false;
+        xo = xfrm_offload(skb);
+        if (!xo || !(xo->flags & XFRM_XMIT))
+                return false;
+        xs = xfrm_input_state(skb);
+        return xs && xs->xso.type == XFRM_DEV_OFFLOAD_PACKET;
+#else
+        return false;
+#endif
+}
