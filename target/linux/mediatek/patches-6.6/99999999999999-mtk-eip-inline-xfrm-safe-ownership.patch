+/* SA/policy retirement uses the same accounting generation fence as all
+ * other HNAT owners. Inbound cleartext remains on the Linux policy path.
+ */
+void foe_clear_crypto_entry(u32 cdrt_idx)
+{
+#if defined(CONFIG_MEDIATEK_NETSYS_V3)
+        struct foe_entry snapshot, *entry;
+        u32 ppe, slot;
+        u64 generation;
+        bool accounted, changed;
+
+        if (!cdrt_idx || !hnat_external_callback_enter())
+                return;
+        for (ppe = 0; ppe < CFG_PPE_NUM; ppe++) {
+                if (!hnat_priv->foe_table_cpu[ppe])
+                        continue;
+                changed = false;
+                for (slot = 0; slot < hnat_priv->foe_etry_num; slot++) {
+                        spin_lock_bh(&hnat_priv->entry_lock);
+                        entry = &hnat_priv->foe_table_cpu[ppe][slot];
+                        accounted = hnat_account_clear_snapshot(hnat_priv, ppe, slot,
+                                                                 &snapshot, &generation);
+                        if (!accounted)
+                                snapshot = *entry;
+                        if (snapshot.bfib1.state == BIND &&
+                            ((IS_IPV4_HNAPT(&snapshot) && snapshot.ipv4_hnapt.cdrt_id == cdrt_idx) ||
+                             (IS_IPV6_5T_ROUTE(&snapshot) && snapshot.ipv6_5t_route.cdrt_id == cdrt_idx))) {
+                                if (!accounted ||
+                                    !hnat_account_clear_if_generation(hnat_priv, ppe, slot, false, generation)) {
+                                        entry->bfib1.state = INVALID;
+                                        dma_wmb();
+                                }
+                                changed = true;
+                        }
+                        spin_unlock_bh(&hnat_priv->entry_lock);
+                }
+                if (changed)
+                        hnat_cache_invalidate(ppe);
+        }
+        hnat_external_callback_exit();
+#endif
+}
+EXPORT_SYMBOL_GPL(foe_clear_crypto_entry);
