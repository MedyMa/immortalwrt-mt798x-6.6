+static DEFINE_SPINLOCK(hnat_cache_lock);
+
+static void __hnat_cache_invalidate(u32 ppe)
+{
+        cr_set_field(hnat_priv->ppe_base[ppe] + PPE_CAH_CTRL, CAH_X_MODE, 1);
+        cr_set_field(hnat_priv->ppe_base[ppe] + PPE_CAH_CTRL, CAH_X_MODE, 0);
+}
+
+void hnat_cache_invalidate(u32 ppe)
+{
+        unsigned long flags;
+
+        if (ppe >= CFG_PPE_NUM || !hnat_priv->ppe_base[ppe])
+                return;
+        spin_lock_irqsave(&hnat_cache_lock, flags);
+        /* Flush the affected PPE without enabling a cache paused by HNAT. */
+        __hnat_cache_invalidate(ppe);
+        spin_unlock_irqrestore(&hnat_cache_lock, flags);
+}
