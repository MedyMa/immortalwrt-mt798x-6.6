+        srcu_read_unlock(&mtk_crypto_srcu, idx);
+}
+
+static void mtk_crypto_state_free(struct xfrm_state *xs)
+{
+        const struct mtk_crypto_net_ops *ops;
+        int idx = srcu_read_lock(&mtk_crypto_srcu);
+
+        ops = srcu_dereference(mtk_crypto_net_ops, &mtk_crypto_srcu);
